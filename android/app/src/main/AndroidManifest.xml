<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        The new-mail notification. Android 13 made this a runtime permission,
        so the count on a notification is only ever shown after the person
        allowed it; the poll worker checks the grant and stays quiet without
        it rather than dropping a notification the system would swallow.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GrapMailApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GrapMail">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GrapMail.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                The home-screen "Compose mail" shortcut resolves to this
                activity with its own action, declared here so the system will
                deliver it. See res/xml/shortcuts.xml for what it promises and
                MainActivity for the one time it is consumed.
            -->
            <intent-filter>
                <action android:name="com.grapsee.grapmail.COMPOSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!--
            The authority an attachment is handed out under when the person
            chooses "Open". Without this the app could only ever say "saved to
            a path", because ACTION_VIEW on a file:// URI is rejected outright
            on modern Android (FileUriExposedException) — which is exactly why
            the affordance was left unfinished. Granting read permission per
            URI, and exposing only the attachment cache directory (see
            res/xml/file_paths.xml), keeps the handoff to one file the person
            just chose.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
