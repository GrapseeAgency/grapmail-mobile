<?xml version="1.0" encoding="utf-8"?>
<!--
    values-pl/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">Oryginalne kolory</string>
    <string name="reader_colours_dark">Ciemne kolory</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">Pokaż oryginalne kolory</string>
    <string name="reader_colours_menu_dark">Pokaż ciemne kolory</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">pokaż oryginalne kolory tego nadawcy</string>
    <string name="reader_colours_action_dark">pokaż w ciemnych kolorach</string>
    <string name="reader_colours_state_original">Wyświetlane są oryginalne kolory</string>
    <string name="reader_colours_state_dark">Wyświetlane są ciemne kolory</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">Poczta od %1$s będzie otwierana na tym urządzeniu w oryginalnych kolorach.</string>
    <string name="reader_colours_remembered_dark">Poczta od %1$s będzie otwierana na tym urządzeniu w ciemnych kolorach.</string>
</resources>
