    <string name="mailbox_feat_swipe_star">Oznacz gwiazdką</string>
    <string name="mailbox_feat_swipe_snooze">Odłóż</string>
    <string name="mailbox_feat_swipe_move">Przenieś do…</string>
    <string name="mailbox_feat_swipe_none">Brak</string>
