<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">سمجھ گیا</string>
    <string name="tip_close">ٹپ بند کریں</string>

    <string name="tip_swipe_title">ترتیب کے لیے سوائپ کریں</string>
    <string name="tip_swipe_body">پیغام کو آرکائیو کرنے کے لیے دائیں، یا ردی میں بھیجنے کے لیے بائیں سوائپ کریں۔</string>

    <string name="tip_long_press_title">ایک ساتھ کئی منتخب کریں</string>
    <string name="tip_long_press_body">پیغام منتخب کرنے کے لیے اسے دبائے رکھیں، پھر دوسروں کو شامل کرنے کے لیے تھپتھپائیں۔</string>

    <string name="tip_categories_title">اپنا ان باکس تقسیم کریں</string>
    <string name="tip_categories_body">صرف ترجیحی، لوگ، نیوز لیٹرز وغیرہ دیکھنے کے لیے چپ پر تھپتھپائیں۔</string>

    <string name="tip_screener_title">نئے بھیجنے والوں کی جانچ</string>
    <string name="tip_screener_body">مینو میں «منظوری کی منتظر» نئے بھیجنے والوں کی میل آپ کی اجازت تک روکے رکھتا ہے۔</string>

    <string name="tip_accounts_title">اکاؤنٹس تیزی سے بدلیں</string>
    <string name="tip_accounts_body">اکاؤنٹ بدلنے یا نیا شامل کرنے کے لیے اپنی تصویر پر تھپتھپائیں۔</string>

    <string name="tip_snooze_title">بعد کے لیے ملتوی کریں</string>
    <string name="tip_snooze_body">منتخب میل کو بہتر وقت تک ملتوی کرنے کے لیے مزید پر تھپتھپائیں۔</string>
</resources>
