<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">বুঝেছি</string>
    <string name="tip_close">টিপ বন্ধ করুন</string>

    <string name="tip_swipe_title">গুছিয়ে নিতে সোয়াইপ করুন</string>
    <string name="tip_swipe_body">আর্কাইভ করতে বার্তা ডানে, বা ট্র্যাশে সরাতে বাঁয়ে সোয়াইপ করুন।</string>

    <string name="tip_long_press_title">একসাথে কয়েকটি বেছে নিন</string>
    <string name="tip_long_press_body">বার্তা বেছে নিতে চেপে ধরে রাখুন, তারপর আরও যোগ করতে অন্যগুলোতে ট্যাপ করুন।</string>

    <string name="tip_categories_title">ইনবক্স ভাগ করুন</string>
    <string name="tip_categories_body">শুধু অগ্রাধিকার, মানুষ, নিউজলেটার ইত্যাদি দেখতে একটি চিপে ট্যাপ করুন।</string>

    <string name="tip_screener_title">নতুন প্রেরক যাচাই করুন</string>
    <string name="tip_screener_body">মেনুর অনুমোদনের অপেক্ষায় নতুন প্রেরকদের মেল আপনি অনুমতি না দেওয়া পর্যন্ত আটকে রাখে।</string>

    <string name="tip_accounts_title">দ্রুত অ্যাকাউন্ট বদলান</string>
    <string name="tip_accounts_body">অ্যাকাউন্ট বদলাতে বা আরেকটি যোগ করতে আপনার ছবিতে ট্যাপ করুন।</string>

    <string name="tip_snooze_title">পরে দেখার জন্য স্নুজ করুন</string>
    <string name="tip_snooze_body">বেছে নেওয়া মেল সুবিধাজনক সময় পর্যন্ত স্নুজ করতে আরও-তে ট্যাপ করুন।</string>
</resources>
