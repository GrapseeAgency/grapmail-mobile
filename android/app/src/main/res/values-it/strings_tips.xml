<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">Ho capito</string>
    <string name="tip_close">Chiudi suggerimento</string>

    <string name="tip_swipe_title">Scorri per fare ordine</string>
    <string name="tip_swipe_body">Scorri un messaggio a destra per archiviarlo o a sinistra per spostarlo nel Cestino.</string>

    <string name="tip_long_press_title">Selezionane più di uno</string>
    <string name="tip_long_press_body">Tieni premuto un messaggio per selezionarlo, poi tocca gli altri per aggiungerli.</string>

    <string name="tip_categories_title">Dividi la posta in arrivo</string>
    <string name="tip_categories_body">Tocca un chip per mostrare solo Priorità, Persone, Newsletter e altro.</string>

    <string name="tip_screener_title">Filtra i nuovi mittenti</string>
    <string name="tip_screener_body">In attesa di approvazione, nel menu, trattiene la posta dei nuovi mittenti finché non li consenti.</string>

    <string name="tip_accounts_title">Cambia account al volo</string>
    <string name="tip_accounts_body">Tocca la tua foto per cambiare account o aggiungerne un altro.</string>

    <string name="tip_snooze_title">Posticipa a dopo</string>
    <string name="tip_snooze_body">Tocca Altro per posticipare la posta selezionata a un momento migliore.</string>
</resources>
