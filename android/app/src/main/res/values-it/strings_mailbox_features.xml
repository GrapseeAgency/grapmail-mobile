<?xml version="1.0" encoding="utf-8"?>
<!--
    values-it/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">Buongiorno</string>
    <string name="mailbox_feat_greeting_morning_name">Buongiorno, %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">Buon pomeriggio</string>
    <string name="mailbox_feat_greeting_afternoon_name">Buon pomeriggio, %1$s</string>
    <string name="mailbox_feat_greeting_evening">Buonasera</string>
    <string name="mailbox_feat_greeting_evening_name">Buonasera, %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="one">%1$d in attesa di risposta</item>
        <item quantity="many">%1$d in attesa di risposta</item>
        <item quantity="other">%1$d in attesa di risposta</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="one">%1$d pacco in arrivo</item>
        <item quantity="many">%1$d di pacchi in arrivo</item>
        <item quantity="other">%1$d pacchi in arrivo</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="one">%1$d codice di accesso</item>
        <item quantity="many">%1$d di codici di accesso</item>
        <item quantity="other">%1$d codici di accesso</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">Non hai nulla in sospeso</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">Mostra i messaggi in attesa di risposta</string>
    <string name="mailbox_feat_action_show_packages">Mostra aggiornamenti sui pacchi</string>
    <string name="mailbox_feat_action_show_codes">Mostra codici di accesso</string>
    <string name="mailbox_feat_action_show_all">Mostra tutti i messaggi</string>
    <string name="mailbox_feat_dismiss">Ignora</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">In attesa di risposta</string>
    <string name="mailbox_feat_filter_packages">Pacchi</string>
    <string name="mailbox_feat_filter_codes">Codici di accesso</string>
    <string name="mailbox_feat_filter_clear">Rimuovi filtro: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">Copia %1$s</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">Copia codice di accesso</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">Codice copiato</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">Codice di accesso</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">Tutto fatto</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="one">Oggi hai gestito %1$d email.</item>
        <item quantity="many">Oggi hai gestito %1$d di email.</item>
        <item quantity="other">Oggi hai gestito %1$d email.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">Niente ti aspetta.</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">Azioni di scorrimento</string>
    <string name="mailbox_feat_swipe_body">Cosa succede quando scorri un messaggio nell\'elenco. Salvato solo su questo dispositivo.</string>
    <string name="mailbox_feat_swipe_right">Scorri a destra</string>
    <string name="mailbox_feat_swipe_left">Scorri a sinistra</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">Modifica: %1$s</string>
    <string name="mailbox_feat_swipe_archive">Archivia</string>
    <string name="mailbox_feat_swipe_trash">Cestino</string>
    <string name="mailbox_feat_swipe_read">Segna come letto/non letto</string>
    <string name="mailbox_feat_swipe_star">Aggiungi a Speciali</string>
    <string name="mailbox_feat_swipe_snooze">Posticipa</string>
    <string name="mailbox_feat_swipe_move">Sposta in…</string>
    <string name="mailbox_feat_swipe_none">Nessuna</string>
</resources>
