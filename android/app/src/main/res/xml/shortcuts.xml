<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen shortcut: long-press the icon, tap "Compose mail", and the
    app opens in the composer.

    It points at MainActivity with its own ACTION rather than at a screen name,
    because a shortcut has to resolve before any navigation graph exists. The
    activity turns the action into one navigation request (see
    `pendingComposeShortcut` in MainActivity), and that request is consumed
    once — a pending request replayed on the next launch would open a composer
    nobody asked for.

    Signed out, the same request lands on sign-in: the honest route to writing
    a mail when there is no session is to get one, not to show a composer whose
    every send would fail.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="compose"
        android:enabled="true"
        android:icon="@drawable/splash_logo"
        android:shortcutShortLabel="@string/shortcut_compose_short"
        android:shortcutLongLabel="@string/shortcut_compose_long">
        <intent
            android:action="com.grapsee.grapmail.COMPOSE"
            android:targetPackage="com.grapsee.grapmail"
            android:targetClass="com.grapsee.grapmail.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
