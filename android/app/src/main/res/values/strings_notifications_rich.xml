<?xml version="1.0" encoding="utf-8"?>
<!--
  Rich mail notifications (logic/Notifications.kt): the one-tap sign-in code
  action. English only for now; a sibling of the other values/*.xml files,
  merged by aapt. Translations go in
  values-<locale>/strings_notifications_rich.xml under the same names.
  The per-account stack reuses existing strings: core_notif_new_messages
  (title), core_notif_generic_new_mail / core_notif_new_encrypted (lines for
  messages whose preview is hidden).
-->
<resources>
    <!-- The notification action that copies a detected one-time sign-in code. -->
    <string name="notif_rich_action_copy_code">Copy code</string>
    <!-- Toast after the code was copied from the notification. The code itself is not repeated. -->
    <string name="notif_rich_code_copied">Code copied</string>
    <!-- Clipboard label for the copied code (shown by some keyboards/clipboard UIs). -->
    <string name="notif_rich_code_clip_label">Sign-in code</string>
    <!-- Notification title with a code in front: %1$s is the code, %2$s the sender. -->
    <string name="notif_rich_title_with_code">%1$s · %2$s</string>
</resources>
