<?xml version="1.0" encoding="utf-8"?>
<!--
    Reader: "Show original colours" for HTML mail in a dark reader.
    English only for now; the locale folders get these in the next translation pass.
    Code: ui/screens/mail/ThreadScreen.kt (message overflow menu + inline pill),
    ui/screens/mail/ReaderAdaptive.kt (ReaderColoursPill),
    ui/screens/mail/ReaderColourPrefs.kt (per-sender memory, this device only).
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">Original colours</string>
    <string name="reader_colours_dark">Dark colours</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">Show original colours</string>
    <string name="reader_colours_menu_dark">Show dark colours</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">show this sender\'s original colours</string>
    <string name="reader_colours_action_dark">show in dark colours</string>
    <string name="reader_colours_state_original">Showing original colours</string>
    <string name="reader_colours_state_dark">Showing dark colours</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">Mail from %1$s will open in its original colours on this device.</string>
    <string name="reader_colours_remembered_dark">Mail from %1$s will open in dark colours on this device.</string>
</resources>
