<?xml version="1.0" encoding="utf-8"?>
<!--
    values-in/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">Selamat pagi</string>
    <string name="mailbox_feat_greeting_morning_name">Selamat pagi, %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">Selamat siang</string>
    <string name="mailbox_feat_greeting_afternoon_name">Selamat siang, %1$s</string>
    <string name="mailbox_feat_greeting_evening">Selamat malam</string>
    <string name="mailbox_feat_greeting_evening_name">Selamat malam, %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="other">%1$d perlu dibalas</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="other">%1$d paket dalam perjalanan</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="other">%1$d kode login</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">Semua sudah beres</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">Tampilkan pesan yang perlu dibalas</string>
    <string name="mailbox_feat_action_show_packages">Tampilkan info paket</string>
    <string name="mailbox_feat_action_show_codes">Tampilkan kode login</string>
    <string name="mailbox_feat_action_show_all">Tampilkan semua pesan</string>
    <string name="mailbox_feat_dismiss">Tutup</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">Perlu dibalas</string>
    <string name="mailbox_feat_filter_packages">Paket</string>
    <string name="mailbox_feat_filter_codes">Kode login</string>
    <string name="mailbox_feat_filter_clear">Hapus filter: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">Salin %1$s</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">Salin kode login</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">Kode disalin</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">Kode login</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">Semua beres</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="other">Anda menangani %1$d email hari ini.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">Tidak ada yang menunggu Anda.</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">Tindakan geser</string>
    <string name="mailbox_feat_swipe_body">Yang terjadi saat Anda menggeser pesan di daftar. Hanya disimpan di perangkat ini.</string>
    <string name="mailbox_feat_swipe_right">Geser ke kanan</string>
    <string name="mailbox_feat_swipe_left">Geser ke kiri</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">Ubah %1$s</string>
    <string name="mailbox_feat_swipe_archive">Arsipkan</string>
    <string name="mailbox_feat_swipe_trash">Sampah</string>
    <string name="mailbox_feat_swipe_read">Tandai dibaca/belum dibaca</string>
    <string name="mailbox_feat_swipe_star">Beri bintang</string>
    <string name="mailbox_feat_swipe_snooze">Tunda</string>
    <string name="mailbox_feat_swipe_move">Pindahkan ke…</string>
    <string name="mailbox_feat_swipe_none">Tidak ada</string>
</resources>
