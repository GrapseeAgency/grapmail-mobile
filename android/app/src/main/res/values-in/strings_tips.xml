<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">Oke</string>
    <string name="tip_close">Tutup tips</string>

    <string name="tip_swipe_title">Geser untuk merapikan</string>
    <string name="tip_swipe_body">Geser pesan ke kanan untuk mengarsipkannya, atau ke kiri untuk memindahkannya ke Sampah.</string>

    <string name="tip_long_press_title">Pilih beberapa sekaligus</string>
    <string name="tip_long_press_body">Sentuh lama pesan untuk memilihnya, lalu ketuk pesan lain untuk menambahkannya.</string>

    <string name="tip_categories_title">Pisahkan kotak masuk</string>
    <string name="tip_categories_body">Ketuk chip untuk hanya menampilkan Prioritas, Orang, Buletin, dan lainnya.</string>

    <string name="tip_screener_title">Saring pengirim baru</string>
    <string name="tip_screener_body">Menunggu persetujuan, di menu, menahan email dari pengirim baru sampai Anda mengizinkannya.</string>

    <string name="tip_accounts_title">Ganti akun dengan cepat</string>
    <string name="tip_accounts_body">Ketuk foto Anda untuk berganti akun atau menambahkan akun lain.</string>

    <string name="tip_snooze_title">Tunda untuk nanti</string>
    <string name="tip_snooze_body">Ketuk Lainnya untuk menunda email terpilih hingga waktu yang lebih tepat.</string>
</resources>
