<?xml version="1.0" encoding="utf-8"?>
<!--
    values-es/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">Colores originales</string>
    <string name="reader_colours_dark">Colores oscuros</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">Mostrar colores originales</string>
    <string name="reader_colours_menu_dark">Mostrar colores oscuros</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">mostrar los colores originales de este remitente</string>
    <string name="reader_colours_action_dark">mostrar en colores oscuros</string>
    <string name="reader_colours_state_original">Mostrando colores originales</string>
    <string name="reader_colours_state_dark">Mostrando colores oscuros</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">El correo de %1$s se abrirá con sus colores originales en este dispositivo.</string>
    <string name="reader_colours_remembered_dark">El correo de %1$s se abrirá en colores oscuros en este dispositivo.</string>
</resources>
