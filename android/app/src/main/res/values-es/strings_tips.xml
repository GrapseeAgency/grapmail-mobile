<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">Entendido</string>
    <string name="tip_close">Cerrar consejo</string>

    <string name="tip_swipe_title">Desliza para ordenar</string>
    <string name="tip_swipe_body">Desliza un mensaje a la derecha para archivarlo o a la izquierda para moverlo a la Papelera.</string>

    <string name="tip_long_press_title">Selecciona varios a la vez</string>
    <string name="tip_long_press_body">Mantén pulsado un mensaje para seleccionarlo y toca otros para añadirlos.</string>

    <string name="tip_categories_title">Divide tu bandeja</string>
    <string name="tip_categories_body">Toca un chip para ver solo Prioritarios, Personas, Boletines y más.</string>

    <string name="tip_screener_title">Filtra remitentes nuevos</string>
    <string name="tip_screener_body">Pendientes de aprobación, en el menú, retiene el correo de remitentes nuevos hasta que los permitas.</string>

    <string name="tip_accounts_title">Cambia de cuenta rápido</string>
    <string name="tip_accounts_body">Toca tu foto para cambiar de cuenta o añadir otra.</string>

    <string name="tip_snooze_title">Posponer para más tarde</string>
    <string name="tip_snooze_body">Toca Más para posponer el correo seleccionado hasta un mejor momento.</string>
</resources>
