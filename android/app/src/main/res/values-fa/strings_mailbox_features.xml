    <string name="mailbox_feat_filter_packages">بسته‌ها</string>
    <string name="mailbox_feat_filter_codes">کدهای ورود</string>
    <string name="mailbox_feat_filter_clear">پاک کردن فیلتر: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">کپی %1$s</string>
