    <string name="mailbox_feat_zero_title">همه‌چیز مرتب است</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="one">امروز به %1$d ایمیل رسیدگی کردید.</item>
        <item quantity="other">امروز به %1$d ایمیل رسیدگی کردید.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">چیزی منتظر شما نیست.</string>

