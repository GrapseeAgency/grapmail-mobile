<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">صبح بخیر</string>
    <string name="mailbox_feat_greeting_morning_name">صبح بخیر، %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">ظهر بخیر</string>
    <string name="mailbox_feat_greeting_afternoon_name">ظهر بخیر، %1$s</string>
    <string name="mailbox_feat_greeting_evening">عصر بخیر</string>
    <string name="mailbox_feat_greeting_evening_name">عصر بخیر، %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="one">%1$d پیام منتظر پاسخ</item>
        <item quantity="other">%1$d پیام منتظر پاسخ</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="one">%1$d بسته در راه</item>
        <item quantity="other">%1$d بسته در راه</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="one">%1$d کد ورود</item>
        <item quantity="other">%1$d کد ورود</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">همه‌چیز را بررسی کرده‌اید</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">،\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">نمایش پیام‌هایی که منتظر پاسخ‌اند</string>
    <string name="mailbox_feat_action_show_packages">نمایش وضعیت بسته‌ها</string>
