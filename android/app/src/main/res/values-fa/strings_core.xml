    <string name="core_template_thanks_name">تشکر کوتاه</string>
    <string name="core_template_thanks_body">سلام {first_name}،\n\nخیلی ممنون از پیامتان — واقعاً قدردانم.\n\nبا احترام،\n{my_name}</string>
