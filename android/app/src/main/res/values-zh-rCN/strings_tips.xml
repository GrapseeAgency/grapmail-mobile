<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">知道了</string>
    <string name="tip_close">关闭提示</string>

    <string name="tip_swipe_title">滑动整理</string>
    <string name="tip_swipe_body">向右滑动邮件可归档，向左滑动可移至已删除。</string>

    <string name="tip_long_press_title">一次选择多封</string>
    <string name="tip_long_press_body">长按邮件即可选中，然后轻点其他邮件来添加。</string>

    <string name="tip_categories_title">拆分收件箱</string>
    <string name="tip_categories_body">轻点标签即可只显示重要、联系人、新闻简报等。</string>

    <string name="tip_screener_title">筛选新发件人</string>
    <string name="tip_screener_body">菜单中的“待批准”会暂存新发件人的邮件，直到你允许为止。</string>

    <string name="tip_accounts_title">快速切换账户</string>
    <string name="tip_accounts_body">轻点你的头像即可切换账户或添加其他账户。</string>

    <string name="tip_snooze_title">稍后再处理</string>
    <string name="tip_snooze_body">轻点“更多”可将所选邮件延后到更合适的时间。</string>
</resources>
