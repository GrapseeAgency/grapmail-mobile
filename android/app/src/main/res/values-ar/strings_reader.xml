<!--
    values-ar/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">الألوان الأصلية</string>
    <string name="reader_colours_dark">الألوان الداكنة</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">عرض الألوان الأصلية</string>
    <string name="reader_colours_menu_dark">عرض الألوان الداكنة</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">عرض الألوان الأصلية لهذا المرسل</string>
    <string name="reader_colours_action_dark">العرض بالألوان الداكنة</string>
    <string name="reader_colours_state_original">يتم عرض الألوان الأصلية</string>
    <string name="reader_colours_state_dark">يتم عرض الألوان الداكنة</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">ستُفتح الرسائل الواردة من %1$s بألوانها الأصلية على هذا الجهاز.</string>
    <string name="reader_colours_remembered_dark">ستُفتح الرسائل الواردة من %1$s بالألوان الداكنة على هذا الجهاز.</string>
</resources>
