    <!-- GrapMailLegalScreen.kt -->
    <string name="acct_terms_of_service">شروط الخدمة</string>
    <string name="acct_privacy_policy">سياسة الخصوصية</string>
    <string name="acct_your_account">حسابك</string>
    <string name="acct_you_must_be_at_least_13_to_create_a">يجب ألا يقل عمرك عن 13 عامًا لإنشاء حساب على GrapMail. حافظ على سرية كلمة المرور، واستخدم إعدادات استرداد الحساب والأمان إذا ظننت أن شخصًا آخر وصل إلى صندوق بريدك.</string>
    <string name="acct_using_grapmail">استخدام GrapMail</string>
    <string name="acct_use_your_mailbox_for_lawful">استخدم صندوق بريدك للتواصل المشروع. لا ترسل رسائل مزعجة أو رسائل جماعية غير مرغوب فيها أو رسائل تصيّد أو برامج ضارة أو رسائل تضايق الآخرين. قد يتم تعليق الحسابات التي تسيء استخدام الخدمة.</string>
    <string name="acct_sending_and_receiving">الإرسال والاستلام</string>
    <string name="acct_a_message_can_be_queued_sent_or_fail">قد تكون الرسالة في قائمة الانتظار أو مُرسلة أو قد يفشل إرسالها. تحقّق من «المُرسلة» ومن أي إشعار تسليم عندما يكون التوقيت مهمًا. الرسالة في قائمة الانتظار لا تزال بانتظار الإرسال.</string>
    <string name="acct_leaving_grapmail">مغادرة GrapMail</string>
    <string name="acct_you_can_sign_out_on_this_device_or">يمكنك تسجيل الخروج على هذا الجهاز أو طلب حذف الحساب من الإعدادات ← البيانات والخصوصية. احفظ أي رسائل تحتاجها قبل حذف حسابك.</string>
    <string name="acct_account_and_mailbox_data">بيانات الحساب وصندوق البريد</string>
    <string name="acct_grapmail_uses_your_account_details">يستخدم GrapMail تفاصيل حسابك لإنشاء صندوق بريدك وتأمينه. تخزّن الخدمة العناوين والرسائل والمرفقات اللازمة لإرسال بريدك واستلامه ومزامنته.</string>
    <string name="acct_security_and_notifications">الأمان والإشعارات</string>
    <string name="acct_google_recaptcha_helps_protect">يساعد Google reCAPTCHA على حماية التسجيل من إساءة الاستخدام. إذا فعّلت تنبيهات البريد الجديد، يمكن لـ GrapMail تسجيل رمز جهاز Firebase لإيصال الإشعارات إلى جهازك. يمكنك تغيير إذن الإشعارات من إعدادات Android.</string>
    <string name="acct_images_and_device_storage">الصور وتخزين الجهاز</string>
    <string name="acct_remote_images_are_hidden_by_default">تكون الصور الخارجية مخفية افتراضيًا في قارئ الرسائل. قد يؤدي عرضها إلى الاتصال بخادم صور المُرسِل. يحتفظ التطبيق أيضًا بذاكرة تخزين مؤقت محلية لصندوق البريد لتظهر الرسائل المحمّلة مؤخرًا بشكل أسرع.</string>
    <string name="acct_encryption_choices">خيارات التشفير</string>
    <string name="acct_grapmail_offers_end_to_end">يوفّر GrapMail تشفيرًا تامًا بين الطرفين للرسائل المدعومة. للبريد العادي والرسائل المشفّرة خصائص خصوصية مختلفة. يمكنك إدارة التشفير ومراجعة تفاصيل حسابك من الإعدادات.</string>
    <string name="acct_control_and_deletion">التحكم والحذف</string>
    <string name="acct_in_settings_data_privacy_you_can">من الإعدادات ← البيانات والخصوصية، يمكنك مراجعة ملفك الشخصي وطلب الحذف. للاستفسار عن مدة الاحتفاظ أو الوصول أو أي طلبات خصوصية أخرى، استخدم رابط التواصل مع Grapsee أدناه.</string>
    <string name="acct_grapmail_guide">دليل GrapMail</string>
    <string name="acct_this_guide_explains_how_grapmail">يشرح هذا الدليل طريقة عمل GrapMail. للاطلاع على المعلومات القانونية الحالية لـ Grapsee، استخدم الصفحة الرسمية أدناه.</string>
    <string name="acct_legal_read_official">اقرأ %1$s الرسمية</string>
    <string name="acct_contact_grapsee">تواصل مع Grapsee</string>

