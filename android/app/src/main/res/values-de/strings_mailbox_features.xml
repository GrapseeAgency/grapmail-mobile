<?xml version="1.0" encoding="utf-8"?>
<!--
    values-de/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">Guten Morgen</string>
    <string name="mailbox_feat_greeting_morning_name">Guten Morgen, %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">Guten Tag</string>
    <string name="mailbox_feat_greeting_afternoon_name">Guten Tag, %1$s</string>
    <string name="mailbox_feat_greeting_evening">Guten Abend</string>
    <string name="mailbox_feat_greeting_evening_name">Guten Abend, %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="one">%1$d wartet auf Antwort</item>
        <item quantity="other">%1$d warten auf Antwort</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="one">%1$d Paket unterwegs</item>
        <item quantity="other">%1$d Pakete unterwegs</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="one">%1$d Anmeldecode</item>
        <item quantity="other">%1$d Anmeldecodes</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">Sie sind auf dem neuesten Stand</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">Nachrichten anzeigen, die auf Antwort warten</string>
    <string name="mailbox_feat_action_show_packages">Paketmeldungen anzeigen</string>
    <string name="mailbox_feat_action_show_codes">Anmeldecodes anzeigen</string>
    <string name="mailbox_feat_action_show_all">Alle Nachrichten anzeigen</string>
    <string name="mailbox_feat_dismiss">Schließen</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">Wartet auf Antwort</string>
    <string name="mailbox_feat_filter_packages">Pakete</string>
    <string name="mailbox_feat_filter_codes">Anmeldecodes</string>
    <string name="mailbox_feat_filter_clear">Filter entfernen: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">%1$s kopieren</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">Anmeldecode kopieren</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">Code kopiert</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">Anmeldecode</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">Alles erledigt</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="one">Sie haben heute %1$d E-Mail bearbeitet.</item>
        <item quantity="other">Sie haben heute %1$d E-Mails bearbeitet.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">Nichts wartet auf Sie.</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">Wischaktionen</string>
    <string name="mailbox_feat_swipe_body">Was ein Wischen über eine Nachricht in der Liste bewirkt. Wird nur auf diesem Gerät gespeichert.</string>
    <string name="mailbox_feat_swipe_right">Nach rechts wischen</string>
    <string name="mailbox_feat_swipe_left">Nach links wischen</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">%1$s ändern</string>
    <string name="mailbox_feat_swipe_archive">Archivieren</string>
    <string name="mailbox_feat_swipe_trash">Papierkorb</string>
    <string name="mailbox_feat_swipe_read">Gelesen/ungelesen</string>
    <string name="mailbox_feat_swipe_star">Markieren</string>
    <string name="mailbox_feat_swipe_snooze">Zurückstellen</string>
    <string name="mailbox_feat_swipe_move">Verschieben nach…</string>
    <string name="mailbox_feat_swipe_none">Keine</string>
</resources>
