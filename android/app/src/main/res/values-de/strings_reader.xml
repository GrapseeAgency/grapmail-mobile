<?xml version="1.0" encoding="utf-8"?>
<!--
    values-de/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">Originalfarben</string>
    <string name="reader_colours_dark">Dunkle Farben</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">Originalfarben anzeigen</string>
    <string name="reader_colours_menu_dark">Dunkle Farben anzeigen</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">Originalfarben dieses Absenders anzeigen</string>
    <string name="reader_colours_action_dark">in dunklen Farben anzeigen</string>
    <string name="reader_colours_state_original">Originalfarben werden angezeigt</string>
    <string name="reader_colours_state_dark">Dunkle Farben werden angezeigt</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">E-Mails von %1$s werden auf diesem Gerät in ihren Originalfarben geöffnet.</string>
    <string name="reader_colours_remembered_dark">E-Mails von %1$s werden auf diesem Gerät in dunklen Farben geöffnet.</string>
</resources>
