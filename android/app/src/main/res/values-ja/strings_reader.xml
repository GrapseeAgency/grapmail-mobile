<?xml version="1.0" encoding="utf-8"?>
<!--
    values-ja/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">元の色</string>
    <string name="reader_colours_dark">ダークカラー</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">元の色で表示</string>
    <string name="reader_colours_menu_dark">ダークカラーで表示</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">この送信者の元の色で表示</string>
    <string name="reader_colours_action_dark">ダークカラーで表示</string>
    <string name="reader_colours_state_original">元の色で表示中</string>
    <string name="reader_colours_state_dark">ダークカラーで表示中</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">この端末では、%1$s からのメールは元の色で開きます。</string>
    <string name="reader_colours_remembered_dark">この端末では、%1$s からのメールはダークカラーで開きます。</string>
</resources>
