<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">확인</string>
    <string name="tip_close">팁 닫기</string>

    <string name="tip_swipe_title">스와이프로 정리하기</string>
    <string name="tip_swipe_body">메일을 오른쪽으로 스와이프하면 보관, 왼쪽으로 스와이프하면 휴지통으로 이동합니다.</string>

    <string name="tip_long_press_title">여러 개 한 번에 선택</string>
    <string name="tip_long_press_body">메일을 길게 눌러 선택한 다음 다른 메일을 탭해 추가하세요.</string>

    <string name="tip_categories_title">받은편지함 나누기</string>
    <string name="tip_categories_body">칩을 탭하면 중요, 사람, 뉴스레터 등만 볼 수 있습니다.</string>

    <string name="tip_screener_title">새 발신자 확인</string>
    <string name="tip_screener_body">메뉴의 승인 대기는 허용하기 전까지 새 발신자의 메일을 보관합니다.</string>

    <string name="tip_accounts_title">계정 빠르게 전환</string>
    <string name="tip_accounts_body">사진을 탭해 계정을 전환하거나 다른 계정을 추가하세요.</string>

    <string name="tip_snooze_title">나중으로 미루기</string>
    <string name="tip_snooze_body">더보기를 탭해 선택한 메일을 더 좋은 시간으로 미루세요.</string>
</resources>
