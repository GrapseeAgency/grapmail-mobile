<?xml version="1.0" encoding="utf-8"?>
<!--
    values-zh-rTW/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">早安</string>
    <string name="mailbox_feat_greeting_morning_name">%1$s，早安</string>
    <string name="mailbox_feat_greeting_afternoon">午安</string>
    <string name="mailbox_feat_greeting_afternoon_name">%1$s，午安</string>
    <string name="mailbox_feat_greeting_evening">晚上好</string>
    <string name="mailbox_feat_greeting_evening_name">%1$s，晚上好</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="other">%1$d 封待回覆</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="other">%1$d 個包裹即將送達</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="other">%1$d 個登入驗證碼</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">已全部處理完畢</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s。%2$s。</string>
    <string name="mailbox_feat_digest_a11y_join">，</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">顯示需要回覆的郵件</string>
    <string name="mailbox_feat_action_show_packages">顯示包裹動態</string>
    <string name="mailbox_feat_action_show_codes">顯示登入驗證碼</string>
    <string name="mailbox_feat_action_show_all">顯示所有郵件</string>
    <string name="mailbox_feat_dismiss">關閉</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">待回覆</string>
    <string name="mailbox_feat_filter_packages">包裹</string>
    <string name="mailbox_feat_filter_codes">登入驗證碼</string>
    <string name="mailbox_feat_filter_clear">清除篩選條件：%1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">複製 %1$s</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">複製登入驗證碼</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">已複製驗證碼</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">登入驗證碼</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">全部完成</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="other">您今天處理了 %1$d 封郵件。</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">沒有待處理的事項。</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">滑動動作</string>
    <string name="mailbox_feat_swipe_body">在清單中滑動郵件時執行的動作。僅儲存在這部裝置上。</string>
    <string name="mailbox_feat_swipe_right">向右滑動</string>
    <string name="mailbox_feat_swipe_left">向左滑動</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">變更%1$s</string>
    <string name="mailbox_feat_swipe_archive">封存</string>
    <string name="mailbox_feat_swipe_trash">垃圾桶</string>
    <string name="mailbox_feat_swipe_read">標示為已讀/未讀</string>
    <string name="mailbox_feat_swipe_star">加上星號</string>
    <string name="mailbox_feat_swipe_snooze">延後</string>
    <string name="mailbox_feat_swipe_move">移至…</string>
    <string name="mailbox_feat_swipe_none">無</string>
</resources>
