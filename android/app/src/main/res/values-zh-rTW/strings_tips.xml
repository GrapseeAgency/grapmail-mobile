<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">知道了</string>
    <string name="tip_close">關閉提示</string>

    <string name="tip_swipe_title">滑動整理</string>
    <string name="tip_swipe_body">向右滑動郵件即可封存，向左滑動則移至垃圾桶。</string>

    <string name="tip_long_press_title">一次選取多封</string>
    <string name="tip_long_press_body">按住郵件即可選取，再點一下其他郵件加入。</string>

    <string name="tip_categories_title">分類收件匣</string>
    <string name="tip_categories_body">點一下標籤即可只顯示重要、聯絡人、電子報等。</string>

    <string name="tip_screener_title">篩選新寄件者</string>
    <string name="tip_screener_body">選單中的「待核准」會保留新寄件者的郵件，直到你允許為止。</string>

    <string name="tip_accounts_title">快速切換帳號</string>
    <string name="tip_accounts_body">點一下你的大頭貼即可切換帳號或新增其他帳號。</string>

    <string name="tip_snooze_title">稍後再處理</string>
    <string name="tip_snooze_body">點一下「更多」即可將所選郵件延後到更合適的時間。</string>
</resources>
