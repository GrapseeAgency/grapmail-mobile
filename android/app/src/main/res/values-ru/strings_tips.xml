<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">Понятно</string>
    <string name="tip_close">Закрыть подсказку</string>

    <string name="tip_swipe_title">Смахните, чтобы навести порядок</string>
    <string name="tip_swipe_body">Смахните письмо вправо, чтобы архивировать, или влево, чтобы переместить в корзину.</string>

    <string name="tip_long_press_title">Выбор нескольких сразу</string>
    <string name="tip_long_press_body">Нажмите и удерживайте письмо, чтобы выбрать его, затем нажимайте другие.</string>

    <string name="tip_categories_title">Разделите входящие</string>
    <string name="tip_categories_body">Нажмите на метку, чтобы показать только Важные, Люди, Рассылки и другое.</string>

    <string name="tip_screener_title">Проверка новых отправителей</string>
    <string name="tip_screener_body">«Ожидают одобрения» в меню задерживает письма новых отправителей, пока вы их не разрешите.</string>

    <string name="tip_accounts_title">Быстрая смена аккаунта</string>
    <string name="tip_accounts_body">Нажмите на фото, чтобы сменить аккаунт или добавить ещё один.</string>

    <string name="tip_snooze_title">Отложите на потом</string>
    <string name="tip_snooze_body">Нажмите «Ещё», чтобы отложить выбранные письма до удобного времени.</string>
</resources>
