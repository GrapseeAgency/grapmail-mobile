    <string name="mail_subs_title">מינויים</string>
    <string name="mail_subs_intro">שולחים שממשיכים לשלוח לחשבון הזה, עם אפשרות לעצור כל אחד מהם.</string>
    <string name="mail_subs_failed">לא ניתן היה לקרוא את תיבת הדואר כרגע. יש לנסות שוב — לפתוח את הדואר הנכנס ואז לחזור.</string>
    <string name="mail_subs_reading">קורא את הדואר שלך…</string>
    <string name="mail_subs_empty_title">לא זוהו מינויים.</string>
    <string name="mail_subs_empty_body">המסך הזה קורא את הדואר הנכנס שהאפליקציה טענה במכשיר — %1$d הודעות — ומקבץ את השולחים שממשיכים לכתוב אליך. שולח נספר אחרי שתי הודעות כשהוא מציע ביטול מינוי, או שלוש כשלא. שום דבר לא מוצג כאן כדוגמה; ברגע שיגיע דואר, השולחים יופיעו עם התדירות ודרך לעצור אותם.</string>
    <string name="mail_subs_delay_note">אחרי ביטול מינוי, ייתכן שיעברו כמה ימים עד שהשולחים יפסיקו לשלוח.</string>
    <string name="mail_subs_mailto_opened">המכשיר פתח טיוטה לכתובת ביטול המינוי של השולח. שום דבר לא יצא מהטלפון עד שתשלח/י אותה.</string>
    <string name="mail_subs_mailto_none">אין במכשיר הזה אפליקציית דואר שיכולה לפתוח את הכתובת הזו, ולכן לא נוצרה טיוטה.</string>
    <string name="mail_subs_scope">המסך הזה קיבץ את %1$d ההודעות הנכנסות שהאפליקציה טענה; שולח שהדואר שלו לא נמצא במכשיר לא מופיע ברשימה.</string>
    <string name="mail_subs_footer">שום דבר לא נשלח לשולח עד שלוחצים על \"ביטול מינוי\". המסך הזה אף פעם לא שולח דואר בשמך מעצמו.</string>
