    <string name="mail_import_assistant_title">עוזר ייבוא ומעבר</string>
    <string name="mail_import_assistant_intro">מעבר ל-GrapMail בשלושה שלבים:</string>
    <string name="mail_import_assistant_step1">1. אצל הספק הקודם יש להפעיל העברה אוטומטית לכתובת GrapMail שלך (בדרך כלל הגדרות ← העברה).</string>
    <string name="mail_import_assistant_step2">2. יש לייצא אנשי קשר כ-vCard (.vcf) ויומנים כ-iCal (.ics), להדביק את התוכן למטה ולאמת לפני הייבוא.</string>
    <string name="mail_import_assistant_step3">3. יש לשלוח הודעת בדיקה אחת מהכתובת הישנה כדי לוודא שההעברה פועלת, ואז לעבור לעבודה השוטפת כאן.</string>
    <string name="mail_import_assistant_paste">הדבקת טקסט .vcf או .ics</string>
    <string name="mail_import_assistant_nothing">עדיין לא הודבק דבר.</string>
    <string name="mail_import_assistant_none_found">לא נמצאו בלוקים של vCard או iCal — יש לבדוק את קובץ הייצוא.</string>
