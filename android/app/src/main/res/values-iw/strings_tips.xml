<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">הבנתי</string>
    <string name="tip_close">סגירת הטיפ</string>

    <string name="tip_swipe_title">החלקה לסידור</string>
    <string name="tip_swipe_body">מחליקים הודעה ימינה כדי להעביר לארכיון, או שמאלה כדי להעביר לאשפה.</string>

    <string name="tip_long_press_title">בחירה של כמה בבת אחת</string>
    <string name="tip_long_press_body">לוחצים לחיצה ארוכה על הודעה כדי לבחור בה, ואז מקישים על אחרות כדי להוסיף.</string>

    <string name="tip_categories_title">פיצול הדואר הנכנס</string>
    <string name="tip_categories_body">מקישים על תווית כדי להציג רק עדיפות, אנשים, ניוזלטרים ועוד.</string>

    <string name="tip_screener_title">סינון שולחים חדשים</string>
    <string name="tip_screener_body">„ממתינות לאישור” בתפריט מחזיקה דואר משולחים חדשים עד שמאשרים אותם.</string>

    <string name="tip_accounts_title">החלפת חשבון מהירה</string>
    <string name="tip_accounts_body">מקישים על התמונה שלך כדי להחליף חשבון או להוסיף חשבון נוסף.</string>

    <string name="tip_snooze_title">דחייה למועד מאוחר</string>
    <string name="tip_snooze_body">מקישים על עוד כדי לדחות את הדואר שנבחר למועד מתאים יותר.</string>
</resources>
