<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">צבעים מקוריים</string>
    <string name="reader_colours_dark">צבעים כהים</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">הצגת הצבעים המקוריים</string>
    <string name="reader_colours_menu_dark">הצגה בצבעים כהים</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">הצגת הצבעים המקוריים של השולח הזה</string>
    <string name="reader_colours_action_dark">הצגה בצבעים כהים</string>
    <string name="reader_colours_state_original">מוצגים הצבעים המקוריים</string>
    <string name="reader_colours_state_dark">מוצגים צבעים כהים</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">דואר מ-%1$s ייפתח במכשיר הזה בצבעים המקוריים שלו.</string>
    <string name="reader_colours_remembered_dark">דואר מ-%1$s ייפתח במכשיר הזה בצבעים כהים.</string>
</resources>
