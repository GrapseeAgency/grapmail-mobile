    <string name="mail_support_can_i_sign_my">אפשר להתחבר עם מספר טלפון?</string>
    <string name="mail_support_yes_sign_page_accepts">כן. דף הכניסה מקבל את כתובת GrapMail או את מספר הטלפון שאימתת, אבל המספר אף פעם אינו זהות החשבון, ודואר אף פעם לא נשלח אליו.</string>
    <string name="mail_support_i_changed_my_number">החלפתי מספר. אאבד את החשבון?</string>
