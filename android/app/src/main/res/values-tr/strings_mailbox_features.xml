<?xml version="1.0" encoding="utf-8"?>
<!--
    values-tr/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">Günaydın</string>
    <string name="mailbox_feat_greeting_morning_name">Günaydın %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">İyi günler</string>
    <string name="mailbox_feat_greeting_afternoon_name">İyi günler %1$s</string>
    <string name="mailbox_feat_greeting_evening">İyi akşamlar</string>
    <string name="mailbox_feat_greeting_evening_name">İyi akşamlar %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="one">%1$d ileti yanıt bekliyor</item>
        <item quantity="other">%1$d ileti yanıt bekliyor</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="one">%1$d paket yolda</item>
        <item quantity="other">%1$d paket yolda</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="one">%1$d giriş kodu</item>
        <item quantity="other">%1$d giriş kodu</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">Her şeyi hallettiniz</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">Yanıt bekleyen iletileri göster</string>
    <string name="mailbox_feat_action_show_packages">Paket güncellemelerini göster</string>
    <string name="mailbox_feat_action_show_codes">Giriş kodlarını göster</string>
    <string name="mailbox_feat_action_show_all">Tüm iletileri göster</string>
    <string name="mailbox_feat_dismiss">Kapat</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">Yanıt bekliyor</string>
    <string name="mailbox_feat_filter_packages">Paketler</string>
    <string name="mailbox_feat_filter_codes">Giriş kodları</string>
    <string name="mailbox_feat_filter_clear">Filtreyi temizle: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">%1$s kodunu kopyala</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">Giriş kodunu kopyala</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">Kod kopyalandı</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">Giriş kodu</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">Her şey tamam</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="one">Bugün %1$d e-postayı hallettiniz.</item>
        <item quantity="other">Bugün %1$d e-postayı hallettiniz.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">Sizi bekleyen bir şey yok.</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">Kaydırma işlemleri</string>
    <string name="mailbox_feat_swipe_body">Listedeki bir iletiyi kaydırdığınızda ne olacağı. Yalnızca bu cihaza kaydedilir.</string>
    <string name="mailbox_feat_swipe_right">Sağa kaydırma</string>
    <string name="mailbox_feat_swipe_left">Sola kaydırma</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">Değiştir: %1$s</string>
    <string name="mailbox_feat_swipe_archive">Arşivle</string>
    <string name="mailbox_feat_swipe_trash">Çöp Kutusu</string>
    <string name="mailbox_feat_swipe_read">Okundu/okunmadı yap</string>
    <string name="mailbox_feat_swipe_star">Yıldızla</string>
    <string name="mailbox_feat_swipe_snooze">Ertele</string>
    <string name="mailbox_feat_swipe_move">Şuraya taşı…</string>
    <string name="mailbox_feat_swipe_none">Yok</string>
</resources>
