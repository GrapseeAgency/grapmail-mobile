    <string name="mail_providers_offline">आप ऑफ़लाइन हैं। इंटरनेट से कनेक्ट करके फिर से कोशिश करें।</string>
    <string name="mail_providers_error">कनेक्ट किए गए खाते लोड नहीं हो सके।</string>
    <string name="mail_providers_outlook_title">Outlook कनेक्ट करें</string>
    <string name="mail_providers_outlook_body">वह Outlook या Microsoft 365 पता डालें जिससे आप साइन इन करेंगे। Microsoft का साइन-इन पेज आपके ब्राउज़र में खुलेगा।</string>
    <string name="mail_providers_outlook_unavailable">इस सर्वर पर अभी Outlook कनेक्ट नहीं किया जा सकता।</string>
    <string name="mail_providers_oauth_state">यह साइन-इन इस ऐप द्वारा शुरू किए गए साइन-इन से मेल नहीं खाता। फिर से शुरू करें।</string>
    <string name="mail_providers_oauth_denied">Microsoft ने ऐक्सेस नहीं दिया। कुछ भी कनेक्ट नहीं हुआ।</string>
    <string name="mail_providers_imap_title">IMAP खाता कनेक्ट करें</string>
    <string name="mail_providers_imap_intro">अपना प्रदाता चुनें। अधिकांश प्रदाताओं के लिए सामान्य पासवर्ड के बजाय ऐप पासवर्ड चाहिए।</string>
    <string name="mail_providers_preset_custom">कस्टम</string>
    <string name="mail_providers_help_app_password">अपने प्रदाता की सुरक्षा सेटिंग में ऐप पासवर्ड बनाएँ और उसे यहाँ पेस्ट करें। आपका सामान्य पासवर्ड आमतौर पर काम नहीं करेगा।</string>
    <string name="mail_providers_help_custom">अपने प्रदाता के सहायता पेज से IMAP और SMTP सर्वर डालें।</string>
