<?xml version="1.0" encoding="utf-8"?>
<!--
    values-hi/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">सुप्रभात</string>
    <string name="mailbox_feat_greeting_morning_name">सुप्रभात, %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">नमस्कार</string>
    <string name="mailbox_feat_greeting_afternoon_name">नमस्कार, %1$s</string>
    <string name="mailbox_feat_greeting_evening">शुभ संध्या</string>
    <string name="mailbox_feat_greeting_evening_name">शुभ संध्या, %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="one">%1$d संदेश को जवाब चाहिए</item>
        <item quantity="other">%1$d संदेशों को जवाब चाहिए</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="one">%1$d पैकेज आ रहा है</item>
        <item quantity="other">%1$d पैकेज आ रहे हैं</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="one">%1$d साइन-इन कोड</item>
        <item quantity="other">%1$d साइन-इन कोड</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">आपने सब कुछ देख लिया है</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">जिन संदेशों को जवाब चाहिए, उन्हें दिखाएँ</string>
    <string name="mailbox_feat_action_show_packages">पैकेज अपडेट दिखाएँ</string>
    <string name="mailbox_feat_action_show_codes">साइन-इन कोड दिखाएँ</string>
    <string name="mailbox_feat_action_show_all">सभी संदेश दिखाएँ</string>
    <string name="mailbox_feat_dismiss">खारिज करें</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">जवाब चाहिए</string>
    <string name="mailbox_feat_filter_packages">पैकेज</string>
    <string name="mailbox_feat_filter_codes">साइन-इन कोड</string>
    <string name="mailbox_feat_filter_clear">फ़िल्टर हटाएँ: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">%1$s कॉपी करें</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">साइन-इन कोड कॉपी करें</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">कोड कॉपी किया गया</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">साइन-इन कोड</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">सब निपट गया</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="one">आपने आज %1$d ईमेल निपटाया।</item>
        <item quantity="other">आपने आज %1$d ईमेल निपटाए।</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">आपके लिए कुछ भी बाकी नहीं है।</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">स्वाइप कार्रवाइयाँ</string>
    <string name="mailbox_feat_swipe_body">सूची में किसी संदेश पर स्वाइप करने से क्या होता है। सिर्फ़ इस डिवाइस पर सेव होता है।</string>
    <string name="mailbox_feat_swipe_right">दाईं ओर स्वाइप</string>
    <string name="mailbox_feat_swipe_left">बाईं ओर स्वाइप</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">%1$s बदलें</string>
    <string name="mailbox_feat_swipe_archive">संग्रहित करें</string>
    <string name="mailbox_feat_swipe_trash">ट्रैश</string>
    <string name="mailbox_feat_swipe_read">पढ़ा/अपठित मार्क करें</string>
    <string name="mailbox_feat_swipe_star">तारांकित करें</string>
    <string name="mailbox_feat_swipe_snooze">स्नूज़ करें</string>
    <string name="mailbox_feat_swipe_move">यहाँ ले जाएँ…</string>
    <string name="mailbox_feat_swipe_none">कोई नहीं</string>
</resources>
