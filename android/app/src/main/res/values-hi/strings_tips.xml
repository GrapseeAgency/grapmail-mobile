<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">समझ गया</string>
    <string name="tip_close">टिप बंद करें</string>

    <string name="tip_swipe_title">व्यवस्थित करने के लिए स्वाइप करें</string>
    <string name="tip_swipe_body">किसी संदेश को संग्रहित करने के लिए दाएँ, या ट्रैश में ले जाने के लिए बाएँ स्वाइप करें।</string>

    <string name="tip_long_press_title">एक साथ कई चुनें</string>
    <string name="tip_long_press_body">किसी संदेश को चुनने के लिए दबाकर रखें, फिर और जोड़ने के लिए दूसरों पर टैप करें।</string>

    <string name="tip_categories_title">अपना इनबॉक्स बाँटें</string>
    <string name="tip_categories_body">सिर्फ़ प्राथमिकता, लोग, न्यूज़लेटर और अन्य देखने के लिए किसी चिप पर टैप करें।</string>

    <string name="tip_screener_title">नए प्रेषकों की जाँच करें</string>
    <string name="tip_screener_body">मेनू में स्वीकृति लंबित, नए प्रेषकों की मेल तब तक रोके रखता है जब तक आप अनुमति न दें।</string>

    <string name="tip_accounts_title">खाते जल्दी बदलें</string>
    <string name="tip_accounts_body">खाता बदलने या दूसरा जोड़ने के लिए अपनी तस्वीर पर टैप करें।</string>

    <string name="tip_snooze_title">बाद के लिए स्नूज़ करें</string>
    <string name="tip_snooze_body">चुनी गई मेल को बेहतर समय तक स्नूज़ करने के लिए और पर टैप करें।</string>
</resources>
