<?xml version="1.0" encoding="utf-8"?>
<!--
    values-fr/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">Couleurs d\'origine</string>
    <string name="reader_colours_dark">Couleurs sombres</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">Afficher les couleurs d\'origine</string>
    <string name="reader_colours_menu_dark">Afficher les couleurs sombres</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">afficher les couleurs d\'origine de cet expéditeur</string>
    <string name="reader_colours_action_dark">afficher en couleurs sombres</string>
    <string name="reader_colours_state_original">Couleurs d\'origine affichées</string>
    <string name="reader_colours_state_dark">Couleurs sombres affichées</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">Les e-mails de %1$s s\'ouvriront avec leurs couleurs d\'origine sur cet appareil.</string>
    <string name="reader_colours_remembered_dark">Les e-mails de %1$s s\'ouvriront en couleurs sombres sur cet appareil.</string>
</resources>
