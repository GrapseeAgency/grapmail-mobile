<?xml version="1.0" encoding="utf-8"?>
<!--
    values-vi/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">Chào buổi sáng</string>
    <string name="mailbox_feat_greeting_morning_name">Chào buổi sáng, %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">Chào buổi chiều</string>
    <string name="mailbox_feat_greeting_afternoon_name">Chào buổi chiều, %1$s</string>
    <string name="mailbox_feat_greeting_evening">Chào buổi tối</string>
    <string name="mailbox_feat_greeting_evening_name">Chào buổi tối, %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="other">%1$d thư cần trả lời</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="other">%1$d gói hàng đang đến</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="other">%1$d mã đăng nhập</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">Bạn đã xem hết thư</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">Hiện thư cần trả lời</string>
    <string name="mailbox_feat_action_show_packages">Hiện cập nhật gói hàng</string>
    <string name="mailbox_feat_action_show_codes">Hiện mã đăng nhập</string>
    <string name="mailbox_feat_action_show_all">Hiện tất cả thư</string>
    <string name="mailbox_feat_dismiss">Bỏ qua</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">Cần trả lời</string>
    <string name="mailbox_feat_filter_packages">Gói hàng</string>
    <string name="mailbox_feat_filter_codes">Mã đăng nhập</string>
    <string name="mailbox_feat_filter_clear">Xóa bộ lọc: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">Sao chép %1$s</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">Sao chép mã đăng nhập</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">Đã sao chép mã</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">Mã đăng nhập</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">Đã xong hết</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="other">Hôm nay bạn đã xử lý %1$d email.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">Không có gì đang chờ bạn.</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">Thao tác vuốt</string>
    <string name="mailbox_feat_swipe_body">Tác dụng khi vuốt một thư trong danh sách. Chỉ lưu trên thiết bị này.</string>
    <string name="mailbox_feat_swipe_right">Vuốt sang phải</string>
    <string name="mailbox_feat_swipe_left">Vuốt sang trái</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">Thay đổi %1$s</string>
    <string name="mailbox_feat_swipe_archive">Lưu trữ</string>
    <string name="mailbox_feat_swipe_trash">Thùng rác</string>
    <string name="mailbox_feat_swipe_read">Đánh dấu đã đọc/chưa đọc</string>
    <string name="mailbox_feat_swipe_star">Gắn dấu sao</string>
    <string name="mailbox_feat_swipe_snooze">Tạm ẩn</string>
    <string name="mailbox_feat_swipe_move">Chuyển đến…</string>
    <string name="mailbox_feat_swipe_none">Không có</string>
</resources>
