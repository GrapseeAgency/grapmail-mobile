    <string name="mail_subs_title">Đăng ký</string>
    <string name="mail_subs_intro">Những người gửi liên tục gửi thư đến tài khoản này, kèm cách dừng từng người.</string>
    <string name="mail_subs_failed">Hiện không đọc được hộp thư. Hãy thử lại — mở Hộp thư đến rồi quay lại.</string>
    <string name="mail_subs_reading">Đang đọc thư của bạn…</string>
    <string name="mail_subs_empty_title">Không phát hiện đăng ký nào.</string>
    <string name="mail_subs_empty_body">Màn hình này đọc thư đến trong Hộp thư đến mà ứng dụng đã tải trên thiết bị này — %1$d thư — và nhóm những người gửi liên tục gửi thư cho bạn. Một người gửi được tính khi có hai thư và có tùy chọn hủy đăng ký, hoặc ba thư nếu không có. Không có gì ở đây là ví dụ; ngay khi thư đến, người gửi sẽ xuất hiện cùng tần suất và cách dừng họ.</string>
    <string name="mail_subs_delay_note">Sau khi bạn hủy đăng ký, người gửi có thể mất vài ngày mới ngừng gửi thư.</string>
    <string name="mail_subs_mailto_opened">Thiết bị đã mở một thư nháp gửi đến địa chỉ hủy đăng ký của người gửi. Chưa có gì rời khỏi điện thoại cho đến khi bạn gửi.</string>
    <string name="mail_subs_mailto_none">Thiết bị này không có ứng dụng thư nào mở được địa chỉ đó nên chưa soạn thư nháp.</string>
    <string name="mail_subs_scope">Màn hình này đã nhóm %1$d thư đến mà ứng dụng đã tải; người gửi có thư không nằm trên thiết bị này sẽ không có trong danh sách.</string>
    <string name="mail_subs_footer">Không có gì được gửi đến người gửi nào cho đến khi bạn nhấn Hủy đăng ký. Màn hình này không bao giờ tự gửi thư thay bạn.</string>
    <string name="mail_subs_removed_note">%1$s Hàng này bị xóa ở đây vì thiết bị không thể thấy trang đó hiển thị gì.</string>
    <string name="mail_subs_no_offer">%1$s không có tùy chọn hủy đăng ký nên thiết bị này không có gì để chuyển tiếp.</string>
    <string name="mail_subs_scope_hint">Khi người gửi có tùy chọn hủy đăng ký một chạm, tùy chọn đó sẽ được dùng; nếu không, trang hủy đăng ký của họ sẽ mở ra.</string>
