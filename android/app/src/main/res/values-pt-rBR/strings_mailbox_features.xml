<?xml version="1.0" encoding="utf-8"?>
<!--
    values-pt-rBR/strings_mailbox_features.xml: translation of values/strings_mailbox_features.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- ui/mailfeatures/MorningCard.kt — greeting by local time; %1$s is the mailbox's first name. -->
    <string name="mailbox_feat_greeting_morning">Bom dia</string>
    <string name="mailbox_feat_greeting_morning_name">Bom dia, %1$s</string>
    <string name="mailbox_feat_greeting_afternoon">Boa tarde</string>
    <string name="mailbox_feat_greeting_afternoon_name">Boa tarde, %1$s</string>
    <string name="mailbox_feat_greeting_evening">Boa noite</string>
    <string name="mailbox_feat_greeting_evening_name">Boa noite, %1$s</string>
    <!-- Summary parts; only non-zero parts are shown, joined by a middle dot. -->
    <plurals name="mailbox_feat_digest_reply">
        <item quantity="one">%1$d precisa de resposta</item>
        <item quantity="many">%1$d precisam de resposta</item>
        <item quantity="other">%1$d precisam de resposta</item>
    </plurals>
    <plurals name="mailbox_feat_digest_package">
        <item quantity="one">%1$d pacote a caminho</item>
        <item quantity="many">%1$d de pacotes a caminho</item>
        <item quantity="other">%1$d pacotes a caminho</item>
    </plurals>
    <plurals name="mailbox_feat_digest_code">
        <item quantity="one">%1$d código de login</item>
        <item quantity="many">%1$d de códigos de login</item>
        <item quantity="other">%1$d códigos de login</item>
    </plurals>
    <string name="mailbox_feat_digest_caught_up">Você está em dia</string>
    <!-- TalkBack reads the card as one sentence: %1$s greeting, %2$s the parts joined. -->
    <string name="mailbox_feat_digest_a11y">%1$s. %2$s.</string>
    <string name="mailbox_feat_digest_a11y_join">,\u0020</string>
    <!-- TalkBack actions on the card. -->
    <string name="mailbox_feat_action_show_reply">Mostrar mensagens que precisam de resposta</string>
    <string name="mailbox_feat_action_show_packages">Mostrar atualizações de pacotes</string>
    <string name="mailbox_feat_action_show_codes">Mostrar códigos de login</string>
    <string name="mailbox_feat_action_show_all">Mostrar todas as mensagens</string>
    <string name="mailbox_feat_dismiss">Dispensar</string>
    <!-- The active filter chip under the card; %1$s is the filter's name. -->
    <string name="mailbox_feat_filter_reply">Precisa de resposta</string>
    <string name="mailbox_feat_filter_packages">Pacotes</string>
    <string name="mailbox_feat_filter_codes">Códigos de login</string>
    <string name="mailbox_feat_filter_clear">Limpar filtro: %1$s</string>

    <!-- ui/components/Mail.kt — the code chip on an inbox row; %1$s is the code. -->
    <string name="mailbox_feat_code_copy">Copiar %1$s</string>
    <!-- The chip's spoken name; the code itself is not read out. -->
    <string name="mailbox_feat_code_copy_a11y">Copiar código de login</string>
    <!-- Shown on the chip after a copy. The code is not repeated. -->
    <string name="mailbox_feat_code_copied">Código copiado</string>
    <!-- Clipboard label (shown by some keyboards/clipboard UIs). -->
    <string name="mailbox_feat_code_clip_label">Código de login</string>

    <!-- ui/mailfeatures/InboxZero.kt -->
    <string name="mailbox_feat_zero_title">Tudo em dia</string>
    <plurals name="mailbox_feat_zero_handled">
        <item quantity="one">Você tratou %1$d e-mail hoje.</item>
        <item quantity="many">Você tratou %1$d de e-mails hoje.</item>
        <item quantity="other">Você tratou %1$d e-mails hoje.</item>
    </plurals>
    <string name="mailbox_feat_zero_nothing">Nada esperando por você.</string>

    <!-- ui/screens/mail/SwipeActionsSetting.kt and the row actions in MailboxScreen.kt -->
    <string name="mailbox_feat_swipe_title">Ações de deslizar</string>
    <string name="mailbox_feat_swipe_body">O que acontece ao deslizar uma mensagem na lista. Salvo somente neste dispositivo.</string>
    <string name="mailbox_feat_swipe_right">Deslizar para a direita</string>
    <string name="mailbox_feat_swipe_left">Deslizar para a esquerda</string>
    <!-- %1$s is "Swipe right" or "Swipe left". -->
    <string name="mailbox_feat_swipe_change">Alterar: %1$s</string>
    <string name="mailbox_feat_swipe_archive">Arquivar</string>
    <string name="mailbox_feat_swipe_trash">Lixeira</string>
    <string name="mailbox_feat_swipe_read">Marcar como lida/não lida</string>
    <string name="mailbox_feat_swipe_star">Marcar com estrela</string>
    <string name="mailbox_feat_swipe_snooze">Adiar</string>
    <string name="mailbox_feat_swipe_move">Mover para…</string>
    <string name="mailbox_feat_swipe_none">Nenhuma</string>
</resources>
