    <string name="acct_terms_of_service">Termos de Serviço</string>
    <string name="acct_privacy_policy">Política de Privacidade</string>
    <string name="acct_your_account">Sua conta</string>
    <string name="acct_you_must_be_at_least_13_to_create_a">Você precisa ter pelo menos 13 anos para criar uma conta GrapMail. Mantenha sua senha em sigilo e use as configurações de recuperação e segurança da conta se achar que outra pessoa acessou sua caixa de correio.</string>
    <string name="acct_using_grapmail">Usando o GrapMail</string>
    <string name="acct_use_your_mailbox_for_lawful">Use sua caixa de correio para comunicações lícitas. Não envie spam, mensagens em massa não solicitadas, phishing, malware ou mensagens que assediem outras pessoas. Contas que fizerem mau uso do serviço podem ser suspensas.</string>
    <string name="acct_sending_and_receiving">Envio e recebimento</string>
    <string name="acct_a_message_can_be_queued_sent_or_fail">Uma mensagem pode ficar na fila, ser enviada ou falhar. Confira Enviados e qualquer aviso de entrega quando o horário for importante. Uma mensagem na fila ainda está aguardando envio.</string>
    <string name="acct_leaving_grapmail">Saindo do GrapMail</string>
    <string name="acct_you_can_sign_out_on_this_device_or">Você pode sair neste dispositivo ou solicitar a exclusão da conta em Configurações → Dados e privacidade. Salve os e-mails de que precisar antes de excluir sua conta.</string>
    <string name="acct_account_and_mailbox_data">Dados da conta e da caixa de correio</string>
    <string name="acct_grapmail_uses_your_account_details">O GrapMail usa os dados da sua conta para criar e proteger sua caixa de correio. O serviço armazena os endereços, mensagens e anexos necessários para enviar, receber e sincronizar seus e-mails.</string>
    <string name="acct_security_and_notifications">Segurança e notificações</string>
    <string name="acct_google_recaptcha_helps_protect">O Google reCAPTCHA ajuda a proteger o cadastro contra abusos. Se você ativar os alertas de novos e-mails, o GrapMail pode registrar um token de dispositivo do Firebase para enviar notificações ao seu aparelho. Você pode alterar o acesso às notificações nas Configurações do Android.</string>
    <string name="acct_images_and_device_storage">Imagens e armazenamento do dispositivo</string>
    <string name="acct_remote_images_are_hidden_by_default">Imagens remotas ficam ocultas por padrão no leitor de mensagens. Exibi-las pode contatar o servidor de imagens do remetente. O app também mantém um cache local da caixa de correio para que os e-mails carregados recentemente fiquem disponíveis mais rápido.</string>
    <string name="acct_encryption_choices">Opções de criptografia</string>
    <string name="acct_grapmail_offers_end_to_end">O GrapMail oferece criptografia de ponta a ponta para mensagens compatíveis. E-mails comuns e mensagens criptografadas têm níveis de privacidade diferentes. Você pode gerenciar a criptografia e revisar os dados da sua conta nas Configurações.</string>
    <string name="acct_control_and_deletion">Controle e exclusão</string>
    <string name="acct_in_settings_data_privacy_you_can">Em Configurações → Dados e privacidade, você pode revisar seu perfil e solicitar a exclusão. Para dúvidas sobre retenção, acesso ou outras solicitações de privacidade, use o link de contato da Grapsee abaixo.</string>
    <string name="acct_grapmail_guide">Guia do GrapMail</string>
    <string name="acct_this_guide_explains_how_grapmail">Este guia explica como o GrapMail funciona. Para as informações legais atuais da Grapsee, acesse a página oficial abaixo.</string>
    <string name="acct_legal_read_official">Leia a versão oficial: %1$s</string>
