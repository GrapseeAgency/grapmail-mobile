<?xml version="1.0" encoding="utf-8"?>
<!--
  First-time feature tips (ui/components/FeatureTip.kt, logic/FeatureTipsStore.kt).
  One tip per app session, anchored to the control it describes. Titles stay
  at four words or fewer, bodies at one sentence under 90 characters. The same
  English text as iOS's "Feature tips" block (GrapMail/en.lproj/Localizable.strings),
  except the long-press tip: on Android a long press selects, on iOS it previews.
-->
<resources>
    <string name="tip_got_it">Entendi</string>
    <string name="tip_close">Fechar dica</string>

    <string name="tip_swipe_title">Deslize para organizar</string>
    <string name="tip_swipe_body">Deslize uma mensagem para a direita para arquivá-la ou para a esquerda para movê-la para a Lixeira.</string>

    <string name="tip_long_press_title">Selecione várias de uma vez</string>
    <string name="tip_long_press_body">Toque e segure uma mensagem para selecioná-la e toque em outras para adicioná-las.</string>

    <string name="tip_categories_title">Divida sua caixa de entrada</string>
    <string name="tip_categories_body">Toque em um chip para mostrar só Prioridade, Pessoas, Newsletters e mais.</string>

    <string name="tip_screener_title">Filtre novos remetentes</string>
    <string name="tip_screener_body">Aguardando aprovação, no menu, segura os e-mails de novos remetentes até você permitir.</string>

    <string name="tip_accounts_title">Troque de conta rápido</string>
    <string name="tip_accounts_body">Toque na sua foto para trocar de conta ou adicionar outra.</string>

    <string name="tip_snooze_title">Adiar para depois</string>
    <string name="tip_snooze_body">Toque em Mais para adiar o e-mail selecionado para um momento melhor.</string>
</resources>
