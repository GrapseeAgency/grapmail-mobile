<?xml version="1.0" encoding="utf-8"?>
<!--
    values-pt-rBR/strings_reader.xml: translation of values/strings_reader.xml (same keys, same order).
    Comments below are kept from the English source for context.
-->
<resources>
    <!-- The inline pill above an HTML body in a dark reader. It names what a tap switches TO. -->
    <string name="reader_colours_original">Cores originais</string>
    <string name="reader_colours_dark">Cores escuras</string>

    <!-- The message overflow menu items (same toggle as the pill). -->
    <string name="reader_colours_menu_original">Mostrar cores originais</string>
    <string name="reader_colours_menu_dark">Mostrar cores escuras</string>

    <!-- TalkBack: the pill's click action ("double-tap to …") and its current state. -->
    <string name="reader_colours_action_original">mostrar as cores originais deste remetente</string>
    <string name="reader_colours_action_dark">mostrar em cores escuras</string>
    <string name="reader_colours_state_original">Mostrando cores originais</string>
    <string name="reader_colours_state_dark">Mostrando cores escuras</string>

    <!-- The note under the message after a change, so the per-sender memory is not a surprise later. -->
    <string name="reader_colours_remembered_original">Os e-mails de %1$s vão abrir com as cores originais neste dispositivo.</string>
    <string name="reader_colours_remembered_dark">Os e-mails de %1$s vão abrir em cores escuras neste dispositivo.</string>
</resources>
