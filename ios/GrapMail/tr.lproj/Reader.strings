/* Attachments: VoiceOver hint on Save all */
"Opens the share sheet, where Save to Files keeps every attachment" = "Paylaşma sayfasını açar; Dosyalar'a Kaydet tüm ekleri saklar";

/* Attachments: VoiceOver label of a picture in the grid. Values: its position, the number of files, its file name */
"Image %lld of %lld, %@" = "Görsel %1$lld/%2$lld, %3$@";

