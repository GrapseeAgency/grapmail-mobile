/* MARK: - End-to-end encryption */
"Your recovery key" = "Kurtarma anahtarınız";
"I have saved it" = "Kaydettim";
"%@\n\nWrite it down or keep it in a password manager. GrapMail cannot show it again, and without it a lost device means lost encrypted mail. A copied key leaves the clipboard after two minutes." = "%@\n\nBir yere yazın veya parola yöneticisinde saklayın. GrapMail bunu tekrar gösteremez; olmadan kaybolan bir cihaz kaybolan şifreli postalar demektir. Kopyalanan anahtar iki dakika sonra panodan silinir.";
"Remove the recovery key?" = "Kurtarma anahtarı kaldırılsın mı?";
"Remove" = "Kaldır";
"Keep it" = "Sakla";
"If you then lose this device, your encrypted mail cannot be recovered anywhere." = "Ardından bu cihazı kaybederseniz şifreli postalarınız hiçbir yerde kurtarılamaz.";
"There is no way to recover a forgotten passphrase." = "Unutulan bir parola ifadesini kurtarmanın yolu yoktur.";
"Publish the public half, so other people can send me encrypted mail." = "Başkalarının bana şifreli posta gönderebilmesi için genel yarısını yayımla.";
"This shares your public key. Your private key is not shared, and never leaves this device." = "Bu, genel anahtarınızı paylaşır. Özel anahtarınız paylaşılmaz ve bu cihazdan asla çıkmaz.";
"Checking…" = "Kontrol ediliyor…";
"A key on this device comes first — create one from the Encryption screen." = "Önce bu cihazda bir anahtar olmalı — Şifreleme ekranından oluşturun.";
"Unlocking the key comes first — the re-wrap needs the old passphrase to open it." = "Önce anahtarın kilidini açın — yeniden sarmalamak için eski parola ifadesi gerekir.";
"The directory answered nothing for that check." = "Dizin bu kontrol için hiçbir şey yanıtlamadı.";
"Found" = "Bulundu";
"Cannot encrypt" = "Şifrelenemez";
"Signing fingerprint %@" = "İmzalama parmak izi %@";
"Restore your key" = "Anahtarınızı geri yükleyin";
"Unlock your key first: the recovery kit is made from it." = "Önce anahtarınızın kilidini açın: kurtarma kiti ondan oluşturulur.";
"The recovery kit was not saved." = "Kurtarma kiti kaydedilmedi.";
"The recovery key was removed. Keep this device safe: it now holds the only copy of your key." = "Kurtarma anahtarı kaldırıldı. Bu cihazı güvende tutun: artık anahtarınızın tek kopyası onda.";
"The recovery kit was not removed." = "Kurtarma kiti kaldırılmadı.";
"Use at least %lld characters for the passphrase." = "Parola ifadesi için en az %lld karakter kullanın.";
"Use at least %lld characters for the new passphrase." = "Yeni parola ifadesi için en az %lld karakter kullanın.";
"The two passphrases do not match." = "İki parola ifadesi eşleşmiyor.";
"That recovery key is not valid. It has 28 letters and numbers." = "Bu kurtarma anahtarı geçerli değil. 28 harf ve rakamdan oluşur.";
"There is no recovery kit for this account." = "Bu hesap için kurtarma kiti yok.";
"Your key is back on this device and unlocked. Encrypted mail opens here again." = "Anahtarınız bu cihaza geri döndü ve kilidi açıldı. Şifreli postalar burada yeniden açılıyor.";
"The key directory did not answer." = "Anahtar dizini yanıt vermedi.";
"Encryption is on. Your key is private to this device until you publish it." = "Şifreleme açık. Anahtarınız yayımlayana kadar yalnızca bu cihazda.";
"Encryption is on, and your key is published so others can find it." = "Şifreleme açık ve anahtarınız başkalarının bulabilmesi için yayımlandı.";
"Your key is saved on this device and stored on the server, but it is not findable by senders yet. That happens when the mailbox is not active. Mail sent to you stays unencrypted until that is fixed." = "Anahtarınız bu cihaza kaydedildi ve sunucuda saklanıyor ancak gönderenler henüz bulamıyor. Bu, posta kutusu etkin olmadığında olur. Düzeltilene kadar size gönderilen postalar şifrelenmez.";
"The directory refused those keys." = "Dizin bu anahtarları reddetti.";
"Unpublished. New mail to you will not be encrypted. Messages already encrypted stay readable on this device." = "Yayından kaldırıldı. Size gelen yeni postalar şifrelenmeyecek. Zaten şifrelenmiş iletiler bu cihazda okunabilir kalır.";
"The directory did not remove the key." = "Dizin anahtarı kaldırmadı.";
"Unlocked for this session. It locks again when the app is closed." = "Bu oturum için kilit açıldı. Uygulama kapatıldığında yeniden kilitlenir.";
"Locked." = "Kilitlendi.";
"This device would not store the updated key." = "Bu cihaz güncellenen anahtarı saklamadı.";
"Passphrase changed. The key itself is unchanged, so old messages still open." = "Parola ifadesi değiştirildi. Anahtarın kendisi değişmedi, bu nedenle eski iletiler hâlâ açılır.";
