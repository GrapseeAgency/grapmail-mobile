<?xml version="1.0" encoding="UTF-8"?>
<!--
  GrapMail privacy manifest — Apple's PrivacyInfo.xcprivacy (app target).

  Every entry below names an API or a data type the code ACTUALLY uses, with
  the file that uses it, and only Apple's own key names are used: App Store
  Connect ignores (or rejects) a category, data type or purpose it does not
  know, which is the same as not declaring it at all. The companion audit lives
  in ../DATA-FLOW.md.

  The widget and the notification-service extension carry their own manifests
  (GrapMailWidget/PrivacyInfo.xcprivacy, NotificationService/PrivacyInfo.xcprivacy):
  Apple reads each bundle's manifest separately.

  The app has no third-party SDKs that collect data, no ad identifiers, no
  analytics, and no tracking domains. `NSPrivacyTracking` is false and
  `NSPrivacyTrackingDomains` is empty because that is the fact: the network
  peers are GrapMail's own API (grapsee.com and api.iqracsc.com, APIClient.swift).

  Round 9 (App Store readiness) corrections:
    - the old "NSPrivacyAccessedAPICategoryFileProvider" is not an Apple
      category; the file-timestamp read in MailStore.swift is now declared under
      NSPrivacyAccessedAPICategoryFileTimestamp;
    - ProcessInfo.systemUptime (APIClient.swift, MailboxModel.swift,
      ProfileModel.swift) is a required-reason API (system boot time) and was
      not declared;
    - the App Group defaults the widget shares (WidgetShared.swift) need their
      own UserDefaults reason (1C8F.1);
    - the data types "MessageContent", "Password" and "OtherData" and the
      purposes "FraudPrevention" / "AccountManagement" are not Apple keys; they
      are replaced by the real ones below, and crash/hang/session reports
      (RemoteConfig.swift CrashReporter) are now declared.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults. CA92.1: the app's own settings and launch state
		     (SessionStore.swift address/name/expiry, RemoteConfig.swift cache,
		     notification and swipe preferences). 1C8F.1: the App Group suite
		     `group.com.grapsee.grapmail` shared with the widget extension
		     (WidgetShared.swift, WidgetBridge.swift, WidgetActionSync.swift).
		     Tokens live in the Keychain, never here. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<!-- File timestamps. MailStore.swift reads `contentModificationDate` of
		     its own cache files (inside the app container) to expire old
		     entries. C617.1: timestamps of files inside the app container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- System boot time. `ProcessInfo.processInfo.systemUptime` measures
		     how long ago the app last loaded a list or retried a renewal
		     (APIClient.swift, MailboxModel.swift, ProfileModel.swift). The value
		     never leaves the device. 35F9.1: elapsed time between in-app events. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Email address: the mailbox itself, plus the optional recovery
		     email. Sent for sign-up, sign-in and every mail call. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Name: first/last/display name on sign-up and profile writes. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Phone number: optional recovery phone and the find-my-address
		     lookup. Apple counts security/fraud prevention as App Functionality. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Emails or text messages: the mail the account sends and receives
		     (MailAPI.swift). E2E-encrypted bodies are stored as envelopes only
		     this app can open (MailE2e.swift). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailsOrTextMessages</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Photos or videos: the profile photo (APIClient.swift uploadAvatar)
		     and images the person attaches to mail. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Other user content: file attachments, notes, tasks, signatures
		     and labels saved to the account. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Contacts: the people the account writes to and hears from, which
		     the Contacts screen lists (derived from the mail, no address-book
		     access). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeContacts</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- User ID: the account id and the GrapMail handle. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Device ID: the random per-install UUID sent as `x-device-id`
		     (SessionStore.swift DeviceId), used for the session list, trusted
		     devices and sign-up limits. Not the advertising identifier. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Coarse location: the server records the IP address and the country
		     of each sign-in for the session list and the security alerts the
		     app shows (APIClient.swift SessionDto / SecurityEventDto). No GPS
		     or device location is ever read. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Other data types: the APNs push token (AppIntegration.swift,
		     POST /grapsee/grapmail/push/register), and the birthday and gender
		     asked at sign-up. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Crash data: MetricKit crash diagnostics and caught exceptions
		     (RemoteConfig.swift CrashReporter). Platform, version, device model
		     and stack only, never the account: not linked. The person can turn
		     it off in Settings ("Send crash reports"). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Performance data: MetricKit hang diagnostics (same reporter). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Other diagnostic data: the one "session" report per launch
		     (platform, version, device model, time) the same reporter sends. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
