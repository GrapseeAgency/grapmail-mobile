/* MARK: - End-to-end encryption */
"Your recovery key" = "Twój klucz odzyskiwania";
"I have saved it" = "Zapisałem(-am) go";
"%@\n\nWrite it down or keep it in a password manager. GrapMail cannot show it again, and without it a lost device means lost encrypted mail. A copied key leaves the clipboard after two minutes." = "%@\n\nZapisz go lub przechowuj w menedżerze haseł. GrapMail nie może pokazać go ponownie, a bez niego utrata urządzenia oznacza utratę zaszyfrowanej poczty. Skopiowany klucz zniknie ze schowka po dwóch minutach.";
"Remove the recovery key?" = "Usunąć klucz odzyskiwania?";
"Remove" = "Usuń";
"Keep it" = "Zachowaj go";
"If you then lose this device, your encrypted mail cannot be recovered anywhere." = "Jeśli potem stracisz to urządzenie, zaszyfrowanej poczty nie będzie można nigdzie odzyskać.";
"There is no way to recover a forgotten passphrase." = "Nie ma sposobu na odzyskanie zapomnianego hasła klucza.";
"Publish the public half, so other people can send me encrypted mail." = "Opublikuj część publiczną, aby inni mogli wysyłać mi zaszyfrowaną pocztę.";
"This shares your public key. Your private key is not shared, and never leaves this device." = "Udostępnia to Twój klucz publiczny. Klucz prywatny nie jest udostępniany i nigdy nie opuszcza tego urządzenia.";
"Checking…" = "Sprawdzanie…";
"A key on this device comes first — create one from the Encryption screen." = "Najpierw potrzebny jest klucz na tym urządzeniu — utwórz go na ekranie Szyfrowanie.";
"Unlocking the key comes first — the re-wrap needs the old passphrase to open it." = "Najpierw odblokuj klucz — do ponownego zabezpieczenia potrzebne jest stare hasło.";
"The directory answered nothing for that check." = "Katalog nie odpowiedział na to sprawdzenie.";
"Found" = "Znaleziono";
"Cannot encrypt" = "Nie można zaszyfrować";
"Signing fingerprint %@" = "Odcisk klucza podpisu %@";
"Restore your key" = "Przywróć klucz";
"Unlock your key first: the recovery kit is made from it." = "Najpierw odblokuj klucz: zestaw odzyskiwania jest z niego tworzony.";
"The recovery kit was not saved." = "Zestaw odzyskiwania nie został zapisany.";
"The recovery key was removed. Keep this device safe: it now holds the only copy of your key." = "Klucz odzyskiwania został usunięty. Chroń to urządzenie: przechowuje teraz jedyną kopię Twojego klucza.";
"The recovery kit was not removed." = "Zestaw odzyskiwania nie został usunięty.";
"Use at least %lld characters for the passphrase." = "Hasło klucza musi mieć co najmniej %lld znaków.";
"Use at least %lld characters for the new passphrase." = "Nowe hasło klucza musi mieć co najmniej %lld znaków.";
"The two passphrases do not match." = "Hasła klucza nie są zgodne.";
"That recovery key is not valid. It has 28 letters and numbers." = "Ten klucz odzyskiwania jest nieprawidłowy. Ma 28 liter i cyfr.";
"There is no recovery kit for this account." = "To konto nie ma zestawu odzyskiwania.";
"Your key is back on this device and unlocked. Encrypted mail opens here again." = "Klucz znów jest na tym urządzeniu i jest odblokowany. Zaszyfrowana poczta znów się tu otwiera.";
"The key directory did not answer." = "Katalog kluczy nie odpowiedział.";
"Encryption is on. Your key is private to this device until you publish it." = "Szyfrowanie jest włączone. Klucz pozostaje prywatny na tym urządzeniu, dopóki go nie opublikujesz.";
"Encryption is on, and your key is published so others can find it." = "Szyfrowanie jest włączone, a klucz jest opublikowany, więc inni mogą go znaleźć.";
"Your key is saved on this device and stored on the server, but it is not findable by senders yet. That happens when the mailbox is not active. Mail sent to you stays unencrypted until that is fixed." = "Klucz jest zapisany na tym urządzeniu i na serwerze, ale nadawcy nie mogą go jeszcze znaleźć. Dzieje się tak, gdy skrzynka nie jest aktywna. Wysyłana do Ciebie poczta pozostanie niezaszyfrowana, dopóki to nie zostanie naprawione.";
"The directory refused those keys." = "Katalog odrzucił te klucze.";
"Unpublished. New mail to you will not be encrypted. Messages already encrypted stay readable on this device." = "Cofnięto publikację. Nowa poczta do Ciebie nie będzie szyfrowana. Już zaszyfrowane wiadomości pozostaną czytelne na tym urządzeniu.";
"The directory did not remove the key." = "Katalog nie usunął klucza.";
"Unlocked for this session. It locks again when the app is closed." = "Odblokowano na tę sesję. Zostanie ponownie zablokowany po zamknięciu aplikacji.";
"Locked." = "Zablokowano.";
"This device would not store the updated key." = "To urządzenie nie zapisało zaktualizowanego klucza.";
"Passphrase changed. The key itself is unchanged, so old messages still open." = "Hasło klucza zmienione. Sam klucz się nie zmienił, więc starsze wiadomości nadal się otwierają.";
"The key has been removed from this device. Any message encrypted to it can no longer be read here." = "Klucz został usunięty z tego urządzenia. Wiadomości zaszyfrowanych tym kluczem nie można już tu odczytać.";
"The directory did not answer." = "Katalog nie odpowiedział.";
"Your key is locked — unlock it before sending encrypted mail." = "Klucz jest zablokowany — odblokuj go przed wysłaniem zaszyfrowanej poczty.";
"This device has no key to open messages with." = "To urządzenie nie ma klucza do otwierania wiadomości.";
"OpenPGP export lives on the web client — this device holds the key, but the gpg-shaped file is built in the browser. Nothing here is missing from your key; it is one action the phone does not offer." = "Eksport OpenPGP jest dostępny w kliencie webowym — to urządzenie przechowuje klucz, ale plik w formacie gpg jest tworzony w przeglądarce. Twojemu kluczowi niczego nie brakuje; to po prostu funkcja, której telefon nie oferuje.";
"That did not go through." = "Nie udało się.";
"Encryption" = "Szyfrowanie";
"Encryption is not available on this device" = "Szyfrowanie jest niedostępne na tym urządzeniu";
"Nothing is wrong with your account. Your mail is unaffected; it simply cannot be encrypted from here." = "Z Twoim kontem wszystko w porządku. Poczta nie jest zagrożona; po prostu nie można jej stąd szyfrować.";
"Create my key" = "Utwórz mój klucz";
"Lock now" = "Zablokuj teraz";
"Restore your key from your recovery key" = "Przywróć klucz z klucza odzyskiwania";
"A recovery kit for this account is stored, locked with your recovery key. Enter it to put your key back on this device and read your encrypted mail again." = "Dla tego konta przechowywany jest zestaw odzyskiwania zablokowany kluczem odzyskiwania. Wpisz go, aby przywrócić klucz na tym urządzeniu i znów czytać zaszyfrowaną pocztę.";
"Use my recovery key" = "Użyj klucza odzyskiwania";
"Recovery key" = "Klucz odzyskiwania";
"Replace the recovery key" = "Zastąp klucz odzyskiwania";
"Create a recovery key" = "Utwórz klucz odzyskiwania";
"Unlock your key to replace the recovery key." = "Odblokuj klucz, aby zastąpić klucz odzyskiwania.";
"Unlock your key to create the recovery key." = "Odblokuj klucz, aby utworzyć klucz odzyskiwania.";
"Remove the recovery key" = "Usuń klucz odzyskiwania";
"Fingerprint" = "Odcisk klucza";
"Key details" = "Szczegóły klucza";
"Who can find your key" = "Kto może znaleźć Twój klucz";
"Change passphrase" = "Zmień hasło klucza";
"Recipient keys" = "Klucze odbiorców";
"Remove the key from this device" = "Usuń klucz z tego urządzenia";
"Checking whether a recovery key is set up…" = "Sprawdzanie, czy klucz odzyskiwania jest skonfigurowany…";
"Set up on %@. If you lose this device, it restores your key on a new one." = "Skonfigurowano %@. Jeśli stracisz to urządzenie, przywróci on klucz na nowym.";
"Set up. If you lose this device, it restores your key on a new one." = "Skonfigurowano. Jeśli stracisz to urządzenie, przywróci on klucz na nowym.";
"Not set up. If you lose this device, your encrypted mail cannot be recovered." = "Nie skonfigurowano. Jeśli stracisz to urządzenie, zaszyfrowanej poczty nie będzie można odzyskać.";
"Your key is unlocked for this session" = "Klucz jest odblokowany na tę sesję";
"Your key is locked" = "Klucz jest zablokowany";
"Encryption is not set up on this device" = "Szyfrowanie nie jest skonfigurowane na tym urządzeniu";
"It is held in memory only and is never written down. Closing the app locks it." = "Jest przechowywany tylko w pamięci i nigdy nie jest zapisywany. Zamknięcie aplikacji go blokuje.";
"It locks again whenever the app is closed. Unlock it to send or read encrypted mail." = "Blokuje się ponownie przy każdym zamknięciu aplikacji. Odblokuj go, aby wysyłać lub czytać zaszyfrowaną pocztę.";
"Without a key, mail to you cannot be encrypted and encrypted mail cannot be read here." = "Bez klucza poczta do Ciebie nie może być szyfrowana, a zaszyfrowanej poczty nie można tu odczytać.";
"Create your key" = "Utwórz swój klucz";
"The key is made here, on this device. The private half never leaves it: that is what makes this end-to-end rather than a promise. It is stored encrypted under a passphrase you choose." = "Klucz jest tworzony tutaj, na tym urządzeniu. Część prywatna nigdy go nie opuszcza: właśnie dlatego jest to szyfrowanie end-to-end, a nie obietnica. Jest przechowywany w postaci zaszyfrowanej hasłem, które wybierzesz.";
"Not by us, and not by you. After setup you can create a recovery key: it restores your key on a new device with a new passphrase. Without the passphrase or the recovery key, nobody can open your encrypted mail, us included." = "Ani przez nas, ani przez Ciebie. Po konfiguracji możesz utworzyć klucz odzyskiwania: przywraca on klucz na nowym urządzeniu z nowym hasłem. Bez hasła klucza lub klucza odzyskiwania nikt nie otworzy Twojej zaszyfrowanej poczty, nawet my.";
"Passphrase" = "Hasło klucza";
"Repeat passphrase" = "Powtórz hasło klucza";
"Creating…" = "Tworzenie…";
"Unlock your key" = "Odblokuj klucz";
"Your passphrase decrypts the key on this device. It is never sent anywhere." = "Hasło klucza odszyfrowuje klucz na tym urządzeniu. Nigdy nie jest nigdzie wysyłane.";
"Unlocking…" = "Odblokowywanie…";
"This device's key" = "Klucz tego urządzenia";
"Read the fingerprint aloud, or send it through another channel, and have the other person confirm it. If the two do not match, the key you have is not theirs." = "Przeczytaj odcisk na głos lub wyślij go innym kanałem i poproś drugą osobę o potwierdzenie. Jeśli się nie zgadzają, posiadany klucz nie należy do niej.";
"Created" = "Utworzono";
"Signing key" = "Klucz podpisu";
"Yes: recipients can verify it was you" = "Tak: odbiorcy mogą sprawdzić, że to Ty";
"None" = "Brak";
"Your public key is published, so anyone sending you mail can encrypt to it. Your private key is not published and never will be." = "Twój klucz publiczny jest opublikowany, więc każdy, kto do Ciebie pisze, może go użyć do szyfrowania. Klucz prywatny nie jest i nigdy nie będzie publikowany.";
"Published fingerprint" = "Opublikowany odcisk";
"Updated" = "Zaktualizowano";
"The key published for your account is NOT the key on this device. Anyone encrypting to you right now is encrypting to a key this device cannot open. If you did not expect this — for example if you set encryption up on another device — publish from this one, or restore that device's key." = "Klucz opublikowany dla Twojego konta NIE jest kluczem z tego urządzenia. Każdy, kto teraz szyfruje do Ciebie, używa klucza, którego to urządzenie nie otworzy. Jeśli się tego nie spodziewasz — np. gdy szyfrowanie skonfigurowano na innym urządzeniu — opublikuj klucz z tego urządzenia lub przywróć klucz tamtego.";
"Unpublish" = "Cofnij publikację";
"Nothing is published for this account, so senders cannot encrypt to you yet. Publishing shares only the public half." = "Dla tego konta nic nie opublikowano, więc nadawcy nie mogą jeszcze szyfrować do Ciebie. Publikacja udostępnia tylko część publiczną.";
"Publishing…" = "Publikowanie…";
"Publish my public key" = "Opublikuj mój klucz publiczny";
"Change your passphrase" = "Zmień hasło klucza";
"This re-locks the same key under a new passphrase. It does not change the key, so messages already encrypted to you stay readable." = "Ten sam klucz zostanie zablokowany nowym hasłem. Klucz się nie zmienia, więc już zaszyfrowane do Ciebie wiadomości pozostaną czytelne.";
"Current passphrase" = "Obecne hasło klucza";
"New passphrase" = "Nowe hasło klucza";
"Changing…" = "Zmienianie…";
"This deletes the private key here. Every message already encrypted to it becomes unreadable — here and anywhere else, permanently. Do this only if you have the key somewhere else, or you accept losing access to that mail." = "To usuwa tu klucz prywatny. Każda wiadomość nim zaszyfrowana stanie się nieczytelna — tutaj i wszędzie, na zawsze. Zrób to tylko wtedy, gdy masz klucz gdzie indziej lub akceptujesz utratę dostępu do tej poczty.";
"Remove from this device" = "Usuń z tego urządzenia";
"Removing…" = "Usuwanie…";
"Yes, delete the key from this device" = "Tak, usuń klucz z tego urządzenia";
"Check that the people you are about to write to have published keys. A found entry shows the fingerprint to compare; an unavailable one says why, in the directory's own words." = "Sprawdź, czy osoby, do których zamierzasz napisać, mają opublikowane klucze. Znaleziony wpis pokazuje odcisk do porównania; niedostępny podaje przyczynę słowami katalogu.";
"Check" = "Sprawdź";
"Back to compose" = "Wróć do pisania";
"That is not an address the directory can look up." = "Tego adresu nie można wyszukać w katalogu.";
"Not a GrapMail address — the directory only knows GrapMail keys." = "To nie jest adres GrapMail — katalog zna tylko klucze GrapMail.";
"There is no GrapMail account at that address." = "Pod tym adresem nie ma konta GrapMail.";
"This person has not published an encryption key yet." = "Ta osoba nie opublikowała jeszcze klucza szyfrowania.";
"The directory gave no reason." = "Katalog nie podał przyczyny.";
"Enter the recovery key you saved when you set it up. It has 28 letters and numbers; dashes and spaces do not matter." = "Wpisz klucz odzyskiwania zapisany podczas konfiguracji. Ma 28 liter i cyfr; łączniki i spacje nie mają znaczenia.";
"Then choose a passphrase for this device. It protects the key here, like the one you set the first time." = "Następnie wybierz hasło klucza dla tego urządzenia. Chroni ono klucz tutaj, jak hasło ustawione za pierwszym razem.";
"Restoring…" = "Przywracanie…";
"Restore my key" = "Przywróć mój klucz";
"That is not a well-formed %@ key." = "To nie jest poprawnie sformatowany klucz %@.";
"That recipient's public key is not a usable X25519 key." = "Klucz publiczny tego odbiorcy nie jest użytecznym kluczem X25519.";
"This key record is damaged." = "Ten rekord klucza jest uszkodzony.";
"An encrypted message needs at least one recipient, or nobody can open it." = "Zaszyfrowana wiadomość wymaga co najmniej jednego odbiorcy, inaczej nikt jej nie otworzy.";
"That is %lld recipients; the limit is %lld." = "Odbiorców: %lld; limit to %lld.";
"This message's envelope is not readable." = "Koperta tej wiadomości jest nieczytelna.";
"Could not open this message: the wrong key, or the ciphertext is damaged." = "Nie udało się otworzyć wiadomości: zły klucz lub uszkodzony szyfrogram.";
"This message uses an envelope version this app does not understand." = "Ta wiadomość używa wersji koperty, której ta aplikacja nie obsługuje.";
"This message was not encrypted to your key, so it cannot be opened here." = "Ta wiadomość nie została zaszyfrowana Twoim kluczem, więc nie można jej tu otworzyć.";
"This message is not signed." = "Ta wiadomość nie jest podpisana.";
"This message is signed by an unexpected key." = "Ta wiadomość jest podpisana nieoczekiwanym kluczem.";
"This message's signature did not verify." = "Nie udało się zweryfikować podpisu tej wiadomości.";
