<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld earlier messages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld wcześniejsza wiadomość</string>
			<key>few</key>
			<string>%lld wcześniejsze wiadomości</string>
			<key>many</key>
			<string>%lld wcześniejszych wiadomości</string>
			<key>other</key>
			<string>%lld wcześniejszej wiadomości</string>
		</dict>
	</dict>
	<key>%lld people</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld osoba</string>
			<key>few</key>
			<string>%lld osoby</string>
			<key>many</key>
			<string>%lld osób</string>
			<key>other</key>
			<string>%lld osoby</string>
		</dict>
	</dict>
	<key>%lld messages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld wiadomość</string>
			<key>few</key>
			<string>%lld wiadomości</string>
			<key>many</key>
			<string>%lld wiadomości</string>
			<key>other</key>
			<string>%lld wiadomości</string>
		</dict>
	</dict>
	<key>%lld attachments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld załącznik</string>
			<key>few</key>
			<string>%lld załączniki</string>
			<key>many</key>
			<string>%lld załączników</string>
			<key>other</key>
			<string>%lld załącznika</string>
		</dict>
	</dict>
	<key>to %lld people</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>do %lld osoby</string>
			<key>few</key>
			<string>do %lld osób</string>
			<key>many</key>
			<string>do %lld osób</string>
			<key>other</key>
			<string>do %lld osoby</string>
		</dict>
	</dict>
</dict>
</plist>
