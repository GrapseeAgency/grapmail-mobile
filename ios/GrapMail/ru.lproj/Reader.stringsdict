<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld earlier messages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld предыдущее письмо</string>
			<key>few</key>
			<string>%lld предыдущих письма</string>
			<key>many</key>
			<string>%lld предыдущих писем</string>
			<key>other</key>
			<string>%lld предыдущего письма</string>
		</dict>
	</dict>
	<key>%lld people</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld участник</string>
			<key>few</key>
			<string>%lld участника</string>
			<key>many</key>
			<string>%lld участников</string>
			<key>other</key>
			<string>%lld участника</string>
		</dict>
	</dict>
	<key>%lld messages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld письмо</string>
			<key>few</key>
			<string>%lld письма</string>
			<key>many</key>
			<string>%lld писем</string>
			<key>other</key>
			<string>%lld письма</string>
		</dict>
	</dict>
	<key>%lld attachments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld вложение</string>
			<key>few</key>
			<string>%lld вложения</string>
			<key>many</key>
			<string>%lld вложений</string>
			<key>other</key>
			<string>%lld вложения</string>
		</dict>
	</dict>
	<key>to %lld people</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld получатель</string>
			<key>few</key>
			<string>%lld получателя</string>
			<key>many</key>
			<string>%lld получателей</string>
			<key>other</key>
			<string>%lld получателя</string>
		</dict>
	</dict>
</dict>
</plist>
