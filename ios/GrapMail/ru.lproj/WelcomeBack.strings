/* ru translation of en.lproj/WelcomeBack.strings (round 9, ios_translations_b). Keys stay English; values translated. */
/*
  GrapMail — WelcomeBack string table (ru). Round 8 — Workstream B.
  Personal welcome-back sign-in, account chooser, and the sign-out sheet's
  "Also remove from this device" row (docs/design/round8-spec.md §2).
  Used through String(localized:table: "WelcomeBack") and
  Text(_:tableName: "WelcomeBack"). Keys are the English source text;
  interpolations are %@. Other languages fall back to these English values
  until translated (spec §7.6).
*/

/* MARK: - Welcome-back screen */
/* Primary button; the argument is the person's first name (max 16 characters). */
"Continue as %@" = "Продолжить как %@";
/* Primary button while the sign-in is running. */
"Signing in…" = "Вход…";
/* Reason line under the address after a session expired or was refused by the server. */
"For your security, please sign in again." = "В целях безопасности войдите снова.";
/* Reason line under the address after another device ended this session. */
"You were signed out from another device." = "Сеанс завершён с другого устройства.";
/* Inline banner; the Continue button is disabled while it shows. */
"You're offline. Connect to sign in." = "Нет подключения к сети. Подключитесь, чтобы войти.";
/* Field error after a wrong password. */
"That password isn't right." = "Неверный пароль.";
/* Text button: leave welcome-back for the standard sign-in form. */
"Use another account" = "Использовать другой аккаунт";
/* Text button and menu item: forget this account on this device. */
"Remove from this device" = "Удалить с этого устройства";
/* Back button accessibility label (landscape layout). */
"Back" = "Назад";
/* VoiceOver label for the masked address: first argument = visible first letters (spelled out), second = last letter, third = domain. */
"Address beginning %@, ending %@ at %@" = "Адрес, который начинается на %@ и заканчивается на %@, домен %@";
/* VoiceOver label for a short masked address: first argument = visible first letter, second = domain. */
"Address beginning %@ at %@" = "Адрес, который начинается на %@, домен %@";
/* Announcement when a passkey signed in a different account than the one chosen; the argument is that account's address. */
"Signed in as %@" = "Выполнен вход как %@";

/* MARK: - Remove from this device */
/* Confirm dialog title; the argument is the first name or the address. */
"Remove %@ from this device?" = "Удалить %@ с этого устройства?";
/* Confirm dialog body. */
"Your account and mail aren't affected. You'll need your address and password to sign in here again." = "Это не повлияет на аккаунт и почту. Чтобы снова войти здесь, понадобятся адрес и пароль.";
/* Snackbar / announcement after removal. */
"Removed from this device" = "Удалено с этого устройства";

/* MARK: - Account chooser */
/* Chooser title. */
"Choose an account" = "Выберите аккаунт";
/* Chooser subtitle. */
"Signed out on this device" = "Выход выполнен на этом устройстве";
/* VoiceOver label for a chooser row: first argument = name, second = masked address. */
"Continue as %@, %@" = "Продолжить как %@, %@";
/* VoiceOver label for a chooser row's overflow menu; the argument is the name. */
"More options for %@" = "Другие действия: %@";

/* MARK: - Sign-out confirmation (account switcher) */
/* Confirmation title; the argument is the account address. */
"Sign out of %@?" = "Выйти из %@?";
/* Checkbox row, default off. */
"Also remove from this device" = "Также удалить с этого устройства";
/* Helper under the checkbox. */
"You'll need to type your address next time." = "В следующий раз нужно будет ввести адрес.";
