<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GrapMail — Reader plurals (it). Italian: one, many (millions), other. -->
<plist version="1.0">
<dict>
	<key>%lld earlier messages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld messaggio precedente</string>
			<key>many</key>
			<string>%lld messaggi precedenti</string>
			<key>other</key>
			<string>%lld messaggi precedenti</string>
		</dict>
	</dict>
	<key>%lld people</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld persona</string>
			<key>many</key>
			<string>%lld persone</string>
			<key>other</key>
			<string>%lld persone</string>
		</dict>
	</dict>
	<key>%lld messages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld messaggio</string>
			<key>many</key>
			<string>%lld messaggi</string>
			<key>other</key>
			<string>%lld messaggi</string>
		</dict>
	</dict>
	<key>%lld attachments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld allegato</string>
			<key>many</key>
			<string>%lld allegati</string>
			<key>other</key>
			<string>%lld allegati</string>
		</dict>
	</dict>
	<key>to %lld people</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>a %lld persona</string>
			<key>many</key>
			<string>a %lld persone</string>
			<key>other</key>
			<string>a %lld persone</string>
		</dict>
	</dict>
</dict>
</plist>
