/* Round 8 — Workstream A (GrapMail visual identity). English base table "Identity".
   Looked up with String(localized: "…", table: "Identity") / Text("…", tableName: "Identity").
   Other languages fall back to these English keys until they are translated. */

/* VoiceOver label for a masked email address (welcome-back, account chooser). First value: its first letters, spelled out. Second: its last letter. Third: the domain. */
"Address beginning %@, ending %@ at %@" = "Address beginning %1$@, ending %2$@ at %3$@";

/* VoiceOver label for a masked email address with no visible last letter. First value: its first letters, spelled out. Second: the domain. */
"Address beginning %@ at %@" = "Address beginning %1$@ at %2$@";
